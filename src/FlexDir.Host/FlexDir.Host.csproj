<Project Sdk="Microsoft.NET.Sdk">

  <!-- exe. Application 진입점과 DI 조립만. 로직 없음 (ARCHITECTURE §1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 트레이 아이콘(NotifyIcon) 하나 때문이다. WPF 에는 알림 영역 API 가 없고,
         Shell_NotifyIcon 을 직접 감싸면 메시지 창·콜백 배관이 이 프로젝트에 자란다. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlexDir.Core\FlexDir.Core.csproj" />
    <ProjectReference Include="..\FlexDir.Shell\FlexDir.Shell.csproj" />
    <ProjectReference Include="..\FlexDir.App\FlexDir.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 조립이 든 shell 구현체를 테스트가 본다. "누가 언제 Dispose 하는가" 가 이 프로젝트의
         계약이고, 그것을 밖으로 열면 조립 대상이 Host 밖에서도 만져진다. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FlexDir.Host.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
