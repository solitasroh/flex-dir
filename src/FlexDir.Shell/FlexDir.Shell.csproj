<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>

    <!-- LibraryImport(소스 생성 P/Invoke)가 문자열을 고정하려면 unsafe 가 필요하다.
         interop 이 이 어셈블리의 존재 이유이므로 여기서만 켠다 — FlexDir.Core 는 순수하게
         남고, 구조 게이트가 그것을 검사한다 (CLAUDE.md §1). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlexDir.Core\FlexDir.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 감시의 Error 경로(버퍼 오버플로)는 실물로 결정적으로 재현할 수 없다.
         FileSystemWatcher 를 만드는 자리를 테스트가 바꿔 끼울 수 있게 열어준다. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FlexDir.Shell.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
