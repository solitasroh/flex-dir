<Window x:Class="FlexDir.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FlexDir.App.Views"
        xmlns:vm="clr-namespace:FlexDir.App.ViewModels"
        xmlns:sorting="clr-namespace:FlexDir.Core.Sorting;assembly=FlexDir.Core"
        xmlns:state="clr-namespace:FlexDir.Core.ViewState;assembly=FlexDir.Core"
        Title="flex-dir"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource WinBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        v:WindowCaption.Enabled="True"
        v:MaximizedFrame.Enabled="True"
        v:MouseNavigationInput.Enabled="True"
        v:ThemeSync.IsDarkMode="{Binding Settings.IsDarkMode}">

    <!-- ═══ 다크모드 (docs/PRD-v2.md §19 · docs/ADR.md ADR-020) ═══
         루트의 Background·Foreground 만 DynamicResource 다 — StaticResource 는 파싱 시점에
         Window.Resources 가 아직 없어 실패한다(파서 순서). DynamicResource 는 지연 조회라
         상관없다. 나머지 264곳은 여전히 StaticResource 다 — ThemeSync 가 Apply 할 때
         "같은 브러시 인스턴스의 Color 를 바꾸는" 것이라 조회 방식과 무관하게 갱신된다
         (Views/ThemePalette.cs 주석 참조). -->

    <!-- ═══ 커스텀 크롬 32 (docs/DESIGN.md §1) ═══
         CaptionHeight 가 위 32px 띠를 OS 캡션으로 넘긴다. 그래서 끌어서 옮기기 ·
         더블클릭 최대화 · Aero Snap · Win+방향키 · 화면 위로 밀어 최대화가 **우리 코드
         없이** 그대로 온다. 직접 만들면 그 다섯을 하나씩 되살려야 하고 거기서 회귀가 난다.
         캡션 위에 놓인 버튼은 IsHitTestVisibleInChrome 으로 다시 꺼내 온다.

         GlassFrameThickness=0 · CornerRadius=0 : 기본값은 DWM 이 유리 테를 그려 넣어
         우리 배경 위에 회색 띠가 남는다. ResizeBorderThickness 는 기본값을 그대로 둔다 —
         숫자를 박으면 배율이 다른 모니터에서 잡히는 폭이 달라진다.

         **최대화 여백은 MaximizedFrame 이 덜어낸다 (2026-08-12 · 앞의 판단을 뒤집었다).**
         최대화하면 창 rect 가 작업영역보다 사방 8px 크고, WindowChrome 은 클라이언트를 창
         rect 전체로 넓히므로 **내용의 바깥 8px 이 그대로 화면 밖으로 나간다** — 32px 캡션
         줄이 24px 만 보인다. 2026-08-06 에 "잘리지 않는다" 로 적었던 것은 PrintWindow 가
         잘린 자리를 검은 테두리로 덮어써서 생긴 착시다. 가른 방법과 WM_GETMINMAXINFO 를
         쓰지 않은 이유는 Views/MaximizedFrame.cs 주석에 있다. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 수치·색은 전부 docs/DESIGN.md §1~§7 이 정본이다. 색은 아래 리소스 사전이 정의하고,
         루트 attribute 둘(창 배경·전경)만 파서 순서 때문에 값을 직접 쓴다 — 같은 §5 값이다. -->

    <!-- ═══ 키보드 맵 — 창 전역 (docs/DESIGN.md §9) ═══
         방향·Enter 류는 페인 목록에 있다. 여기는 포커스와 무관한 전역 키만 둔다. -->
    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding ActiveTab.GoBackCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ActiveTab.GoForwardCommand}" />
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding ActiveTab.GoUpCommand}" />
        <KeyBinding Key="F5" Command="{Binding ActiveTab.RefreshCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding ActiveTab.CopySelectionCommand}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding ActiveTab.CutSelectionCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding ActiveTab.PasteCommand}" />
        <KeyBinding Key="Delete" Command="{Binding ActiveTab.DeleteSelectionCommand}" />
        <KeyBinding Key="F2" Command="{Binding ActiveTab.BeginRenameCommand}" />
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding ActiveTab.CreateFolderCommand}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding ActiveTab.SelectAllCommand}" />
        <KeyBinding Key="Tab" Command="{Binding SwitchPaneCommand}" />
        <KeyBinding Key="F6" Command="{Binding SwitchPaneCommand}" />
        <KeyBinding Key="C" Modifiers="Control+Alt" Command="{Binding CopyToOtherPaneCommand}" />
        <KeyBinding Key="M" Modifiers="Control+Alt" Command="{Binding MoveToOtherPaneCommand}" />
        <KeyBinding Key="O" Modifiers="Control+Alt" Command="{Binding OpenOtherPaneLocationCommand}" />
        <!-- 탭 (docs/DESIGN.md §9 §탭 · docs/PRD-v2.md §17). **바꾸는 키가 0개다** — 일곱
             조합이 전부 비어 있음을 이 목록 전수로 확인했다. Tab·F6 은 페인 전환 그대로이고
             Ctrl+숫자는 정렬 그대로다. 전부 활성 페인으로 간다 -->
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding NewTabCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}" />
        <!-- 같은 동작의 두 번째 자리 — 탐색기·브라우저가 둘 다 이 쌍을 쓴다 -->
        <KeyBinding Key="PageDown" Modifiers="Control" Command="{Binding NextTabCommand}" />
        <KeyBinding Key="PageUp" Modifiers="Control" Command="{Binding PreviousTabCommand}" />
        <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding ReopenClosedTabCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ActiveTab.ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Name}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ActiveTab.ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Size}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ActiveTab.ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Type}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding ActiveTab.ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Modified}" />
        <!-- 뷰 4종. 탐색기는 Ctrl+Shift+1~8 이지만 우리 뷰는 4종이라 툴바 버튼 순서에 맞춘다 -->
        <KeyBinding Key="D1" Modifiers="Control+Shift" Command="{Binding ActiveTab.ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.Details}" />
        <KeyBinding Key="D2" Modifiers="Control+Shift" Command="{Binding ActiveTab.ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.List}" />
        <KeyBinding Key="D3" Modifiers="Control+Shift" Command="{Binding ActiveTab.ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.Tiles}" />
        <KeyBinding Key="D4" Modifiers="Control+Shift" Command="{Binding ActiveTab.ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.LargeIcons}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- ═══ 색 토큰 (docs/DESIGN.md §5) ═══ -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
        <SolidColorBrush x:Key="WinBgBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="ChromeBgBrush" Color="#F9F9F9" />
        <SolidColorBrush x:Key="PaneBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B" />
        <SolidColorBrush x:Key="Text2Brush" Color="#616161" />
        <SolidColorBrush x:Key="TextDisabledBrush" Color="#9D9D9D" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#E5E5E5" />
        <SolidColorBrush x:Key="StrokeStrongBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="HoverBrush" Color="#0C000000" />
        <SolidColorBrush x:Key="PressedBrush" Color="#14000000" />
        <SolidColorBrush x:Key="SelBrush" Color="#240067C0" />
        <SolidColorBrush x:Key="SelHoverBrush" Color="#330067C0" />
        <SolidColorBrush x:Key="SelInactiveBrush" Color="#12000000" />
        <SolidColorBrush x:Key="FocusRingBrush" Color="#1B1B1B" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />

        <!-- ═══ WPF 기본 크롬 재도색 (docs/PRD-v2.md §19) ═══
             암묵적 스타일(x:Key 없음)이다 — TargetType 만 걸린 인스턴스에 자동으로 붙는다.
             이 파일의 색 있는 스타일은 전부 명시적으로 골라 쓰지만(Style="{StaticResource X}"),
             그런 골라 쓰기는 여기 스타일을 자동으로 물려받지 않는다 — 그래서 아래 각 명시적
             MenuItem·CheckBox·RadioButton 스타일에 BasedOn="{StaticResource {x:Type T}}" 를
             달아 여기로 연결한다. 반대로 ContextMenu·ToolTip·ScrollBar·Separator 는 Style 을
             직접 걸지 않으므로 여기 있는 것만으로 전부 적용된다. -->

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ChromeBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,4" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ChromeBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 기본 항목 모양 — 아이콘 열은 체크 표시 자리다. 하위 메뉴가 없는 항목이 대부분이라
             (PinMenuItem·FavoriteMenuItem·GroupOptionItem·SplitOptionItem) Popup 은 열리는 일이
             드물지만, 언젠가 자식을 다는 항목이 생겨도 구멍이 없도록 갖춰 둔다. -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Check" Grid.Column="0" Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons" FontSize="12" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" />

                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                   VerticalAlignment="Center"
                                                   TextElement.Foreground="{TemplateBinding Foreground}" />

                                <!-- 하위 항목이 뜨는 자리. MenuItem 템플릿은 Popup 을 직접 들어야 한다 -->
                                <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" AllowsTransparency="True"
                                       Focusable="False" Placement="Right" PlacementTarget="{Binding ElementName=Chrome}"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                                    <Border Background="{DynamicResource ChromeBgBrush}"
                                            BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="2">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    Background="{DynamicResource PaneBgBrush}"
                                    BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1">
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Foreground="{DynamicResource PaneBgBrush}" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16">
                                <Ellipse Fill="{DynamicResource PaneBgBrush}"
                                         Stroke="{DynamicResource StrokeStrongBrush}" StrokeThickness="1" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 얇은 Fluent 형 — 화살표 없이 트랙+썸뿐이다. PageUp/Down 은 트랙 클릭이 대신한다.
             크기·정렬은 여기서 정하지 않는다 — 세로/가로에서 반대축이 다르고, 그것은
             ScrollBar 템플릿의 트리거가 이름으로 찾아 방향에 맞춰 건다 (아래). -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Background="{DynamicResource StrokeStrongBrush}" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="14" />
            <Setter Property="MinWidth" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False"
                                   Margin="4,0,4,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackButton}"
                                                  Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackButton}"
                                                  Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ThumbBar" Style="{StaticResource ScrollThumb}"
                                           Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="PART_Track" Property="Margin" Value="0,4,0,4" />
                                <Setter TargetName="ThumbBar" Property="Width" Value="NaN" />
                                <Setter TargetName="ThumbBar" Property="Height" Value="6" />
                                <Setter TargetName="ThumbBar" Property="HorizontalAlignment" Value="Stretch" />
                                <Setter TargetName="ThumbBar" Property="VerticalAlignment" Value="Center" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="14" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="14" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <v:NameMembershipConverter x:Key="NameMembership" />
        <v:NameEqualityConverter x:Key="NameEquality" />
        <v:EnumEqualityConverter x:Key="EnumEquality" />
        <v:SameInstanceConverter x:Key="SameInstance" />
        <v:ViewSourceConverter x:Key="ViewSource" />
        <v:ThumbnailImageConverter x:Key="ThumbnailImage" />
        <v:FoldedOrderToVisibility x:Key="FoldedOrderToVisibility" />

        <!-- WPF 내장이다. 업데이트 알림 바 하나 때문에 변환기를 새로 만들지 않는다. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <v:ColumnWidthConverter x:Key="ColumnWidth" />

        <!-- 툴바 버튼 32×28 · 아이콘 16 (docs/DESIGN.md §1·§7) -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 캡션 버튼 46×32 (목업 .titlebar .caption-btns button). 글리프는 Windows 의
             캡션 전용 코드포인트다 — 최소화 E921 · 최대화 E922 · 복원 E923 · 닫기 E8BB
             (docs/DESIGN.md §7). 크기 10 인 이유는 이 글리프들이 이미 버튼 크기를 전제로
             그려져 있어서다. 툴바 버튼과 달리 모서리를 굴리지 않는다 — 창 오른쪽 끝까지
             꽉 차야 Fitts 의 법칙대로 모서리로 던져 닫을 수 있다. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- 호버·눌림을 템플릿이 아니라 Style 에 두는 이유: 템플릿 트리거가
                         TargetName 으로 Border 를 직접 집으면 TemplateBinding 을 덮어써서
                         파생 스타일(닫기의 빨강)이 영원히 못 이긴다. -->
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 최대화 버튼만 글리프가 상태를 따라간다. 최대화 중에는 '복원' 을 보여야 한다. -->
        <Style x:Key="MaximizeButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Content" Value="&#xE922;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 닫기만 호버가 빨강이다 (목업 .close:hover). 되돌릴 수 없어 보이는 조작에
             경고색을 주는 것은 Windows 관례이고, 여기서는 실제로는 숨기기다 (ADR-003). -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Content" Value="&#xE8BB;" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 뷰 버튼 — 지금 뷰는 강조된다 (목업 .tbtn.on). 어느 뷰인가는 Tag 로 온다:
             ConverterParameter 는 바인딩이 될 수 없어 비교를 버튼마다 미리 접어 둔다. -->
        <Style x:Key="ViewButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers>
                <!-- Trigger 가 아니라 DataTrigger 다 — Tag 는 object 라 Trigger 의 Value 가
                     문자열 "True" 로 남고 bool 과 영원히 다르다 (실물에서 강조가 안 붙었다) -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- breadcrumb 한 칸 (목업 .addr .seg). 높이는 주소 입력 영역 24 안에 들어간다 -->
        <Style x:Key="CrumbButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="3" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 툴바의 드롭다운 머리 — ToolButton 과 같은 크기·크롬. Menu/MenuItem 을 쓰는 이유는
             눌러서 펴지는 것이 내장이라 코드비하인드가 필요 없기 때문이다 (CLAUDE.md §2) -->
        <!-- 페인 사이의 스플리터. 분할이 들어오며 축이 둘이 되어(가로·세로) 인라인으로
             두 벌 쓸 수 없게 됐다 — 트리 스플리터는 여전히 자기 것을 인라인으로 든다. -->
        <Style x:Key="PaneSplitter" TargetType="GridSplitter">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolMenu" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <!-- 아이콘 폰트를 여기 걸면 안 된다 — FontFamily 는 상속되므로 하위 메뉴의
                 한글 항목이 전부 두부(□)가 된다. 글리프를 그리는 TextBlock 에만 건다 -->
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Chrome" CornerRadius="4" Background="Transparent">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Header}"
                                           FontFamily="Segoe Fluent Icons" FontSize="16"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- 하위 항목이 뜨는 자리. MenuItem 템플릿은 Popup 을 직접 들어야 한다 -->
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                       Placement="Bottom" PlacementTarget="{Binding ElementName=Chrome}"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                                    <Border Background="{DynamicResource ChromeBgBrush}"
                                            BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="2">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ 분류 방법 (docs/PRD-v2.md §6-1 · ADR-017) ═══
             항목 다섯은 PaneViewModel.GroupOptions 가 소유한다 — 툴바와 컬럼 헤더 우클릭이
             같은 목록을 쓴다. XAML 두 곳에 두 벌 쓰면 곧 어긋나고 체크 표시도 채점할 수 없다. -->
        <Style x:Key="GroupOptionItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Label}" />
            <!-- 본문 글꼴을 명시한다 (docs/DESIGN.md §4). 툴바 드롭다운은 아이콘 폰트를 쓰는
                 버튼 아래에 달리므로, 비워 두면 상속으로 한글이 두부가 된다 -->
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
            <Setter Property="IsCheckable" Value="True" />
            <!-- Key 가 null 인 "없음" 도 그대로 넘긴다 = 그룹화 끔 -->
            <Setter Property="CommandParameter" Value="{Binding Key}" />
        </Style>

        <!-- ═══ 분할 (docs/PRD-v2.md §18) ═══
             항목 넷은 WorkspaceViewModel.SplitOptions 가 소유한다 — 분류 방법과 같은 이유다
             (체크 표시를 채점할 수 있어야 한다). 커맨드는 항목의 DataContext(SplitOption)에
             없으므로 메뉴에서 끌어온다. -->
        <Style x:Key="SplitOptionItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Label}" />
            <!-- 본문 글꼴을 명시한다 (docs/DESIGN.md §4). 아이콘 폰트를 쓰는 버튼 아래에
                 달리므로, 비워 두면 상속으로 한글이 두부가 된다 -->
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
            <Setter Property="IsCheckable" Value="True" />
            <Setter Property="CommandParameter" Value="{Binding Count}" />
            <Setter Property="Command"
                    Value="{Binding DataContext.SetSplitCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
        </Style>

        <!-- 헤더 우클릭용. x:Shared="False" 로 참조마다 새 인스턴스를 만든다 —
             하나를 여러 페인이 나눠 쓰면 PlacementTarget 이 엇갈린다 -->
        <ContextMenu x:Key="GroupByMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     ItemsSource="{Binding GroupOptions}"
                     ItemContainerStyle="{StaticResource GroupOptionItem}">
            <ContextMenu.Resources>
                <!-- ItemContainerStyle 이 Command 를 못 든다 — 항목의 DataContext 는
                     GroupOption 이라 ChangeGroupCommand 가 거기 없다. 메뉴에서 끌어온다 -->
                <Style TargetType="MenuItem" BasedOn="{StaticResource GroupOptionItem}">
                    <Setter Property="Command"
                            Value="{Binding DataContext.ChangeGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </Style>
            </ContextMenu.Resources>
        </ContextMenu>

        <!-- Details 컬럼 헤더 버튼 — 클릭이 정렬이다 (ChangeSortCommand).
             우클릭은 분류 메뉴다. **버튼이 헤더를 꽉 채우므로 여기에도 달아야 한다** —
             Grid 에만 달면 우클릭의 원본이 늘 버튼이라 메뉴가 뜨지 않는다 (실물에서 확인) -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="ContextMenu" Value="{StaticResource GroupByMenu}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 정렬 방향 표시 ▲/▼ (Segoe Fluent E70E/E70D · docs/DESIGN.md §6) -->
        <!-- 컬럼 경계를 끄는 자리 (사용자 요청 2026-08-10 — 긴 이름이 안 보였다).
             GridSplitter 가 아니라 Thumb 이다: 그것은 인접한 두 열을 함께 조절해서
             한 열을 늘리면 옆 열이 줄어드는 시소가 된다 (Views/ColumnSync.cs).
             자기 열의 오른쪽 끝에 붙고, 어느 열인지는 Tag 가 말한다. -->
        <Style x:Key="ColumnGrip" TargetType="Thumb">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Width" Value="6" />
            <Setter Property="Margin" Value="0,0,-3,0" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <!-- 배경이 있어야 마우스가 잡힌다. 투명이면 히트 테스트가 지나간다. -->
                        <Border x:Name="Grip" Background="Transparent">
                            <Rectangle x:Name="Line" Width="1" HorizontalAlignment="Center"
                                       Fill="{DynamicResource StrokeBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="Text" Value="&#xE70E;" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Sort[0].Descending}" Value="True">
                    <Setter Property="Text" Value="&#xE70D;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ 항목 크롬 — 뷰 4종이 공유한다 (docs/DESIGN.md §6) ═══
             Tag 가 판정을 실어 나른다. 선택은 이름 집합이 들고 있으므로 (ADR-011) 행마다
             "내 이름이 집합에 있는가" 를 묻는다 — 가상화가 실현한 것만 계산한다. -->
        <Style x:Key="ItemSelection" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Tag">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource NameMembership}">
                        <Binding Path="DataContext.Selection.SelectedNames" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                        <Binding Path="Name" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <!-- 선택 — 비활성 페인은 강등된다. 뒤에 오는 트리거가 이기므로 순서가 규칙이다 -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelInactiveBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding Path=(v:PaneChrome.IsActive), RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SelBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding Path=(v:PaneChrome.IsActive), RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SelHoverBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 키보드 포커스 테두리 — 활성 페인에서만. 두께는 항상 1 이라 레이아웃이 흔들리지 않는다 -->
        <Style x:Key="ItemFocus" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Tag">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource NameEquality}">
                        <Binding Path="DataContext.FocusedName" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                        <Binding Path="Name" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding Path=(v:PaneChrome.IsActive), RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ 이름변경 인라인 편집 (docs/DESIGN.md §9-1) ═══
             편집기를 여는 것은 행 템플릿이다 — RenamingName 과 자기 이름을 비교한다. 그래서
             아직 목록에 없는 이름(방금 만든 폴더)도 그 항목이 들어오는 순간 저절로 열린다.
             Collapsed 인 요소는 측정되지 않아 TextBox 템플릿이 적용되지 않는다 — 행마다
             편집기를 미리 두어도 실현 비용은 객체 하나다. -->
        <Style x:Key="EditingName" TargetType="FrameworkElement">
            <Setter Property="Tag">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource NameEquality}">
                        <Binding Path="DataContext.RenamingName" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                        <Binding Path="Name" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 이름 글자 — 편집 중에는 자리를 편집기에 내준다 -->
        <Style x:Key="ItemName" TargetType="TextBlock" BasedOn="{StaticResource EditingName}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 편집기 — AddressFocus.IsAddressBox 를 달지 않는다. 주소줄을 표시로 찾는 이유가
             바로 이 TextBox 다 (Views/AddressFocus.cs) -->
        <Style x:Key="ItemNameEditor" TargetType="TextBox" BasedOn="{StaticResource EditingName}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PaneBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="v:RenameEditor.Enabled" Value="True" />
            <Setter Property="v:RenameEditor.CommitCommand"
                    Value="{Binding DataContext.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="v:RenameEditor.CancelCommand"
                    Value="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 아이콘·썸네일. 썸네일이 있으면 그것, 없으면 형식 아이콘이다 — 크기만 뷰가 정한다.
             96 요청은 SHIL_JUMBO 의 256×256 을 내므로 축소가 여기서 일어난다 -->
        <Style x:Key="ItemIcon" TargetType="Image">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="Source">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource ThumbnailImage}">
                        <Binding Path="Thumbnail" />
                        <Binding Path="Icon" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Details 행 (docs/DESIGN.md §2·§3) — 높이 24 고정 ═══ -->
        <DataTemplate x:Key="DetailsRow" DataType="{x:Type vm:FileItemViewModel}">
            <Border Style="{StaticResource ItemSelection}" Height="24">
                <Border Style="{StaticResource ItemFocus}">
                    <!-- 헤더를 따라온다. 끌 수 있는 것은 헤더뿐이고 (Views/ColumnSync.cs)
                         행은 같은 값에 단방향으로 묶인다 — 정본이 둘이면 어긋난다. -->
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding DataContext.NameColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ColumnWidth}}" />
                            <ColumnDefinition Width="{Binding DataContext.SizeColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ColumnWidth}}" />
                            <ColumnDefinition Width="{Binding DataContext.TypeColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ColumnWidth}}" />
                            <ColumnDefinition Width="{Binding DataContext.ModifiedColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ColumnWidth}}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Style="{StaticResource ItemIcon}" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemName}" Text="{Binding Name}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBox Grid.Column="1" Style="{StaticResource ItemNameEditor}" Margin="6,0,0,0" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Margin="8,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource Text2Brush}" />
                        <TextBlock Grid.Column="2" Text="{Binding TypeText}" Margin="8,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text2Brush}" />
                        <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Margin="8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text2Brush}" />
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>

        <!-- ═══ 그룹화를 켠 Details (docs/PRD-v2.md §6-1) ═══
             헤더도 행이다. 그래서 목록은 여전히 평평한 한 겹이고 VirtualizingStackPanel 이
             그대로 산다 — 전작이 그룹핑으로 가상화를 깨뜨린 자리를 이렇게 피한다.
             WPF 내장 GroupStyle 을 쓰지 않는 이유가 그것이다. -->
        <DataTemplate x:Key="DetailsGroupedRow" DataType="{x:Type vm:DetailRowViewModel}">
            <Grid>
                <!-- 헤더. 클릭이 접기·펴기다 (ListInput 은 이 자리를 빈 곳으로 보지 않는다) -->
                <Button x:Name="Header" Visibility="Collapsed" Height="28" Focusable="False"
                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                        Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding Label}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="8,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <!-- Segoe Fluent E70D(▼ 펼침) / E70E(▲ 접힘)  — SortGlyph 와 같은 글꼴 -->
                        <TextBlock x:Name="Chevron" FontFamily="Segoe Fluent Icons" FontSize="8" Text="&#xE70D;"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" />
                        <TextBlock Text="{Binding Label}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                        <!-- 접혀 있을 때 개수가 그 그룹의 유일한 단서다 -->
                        <TextBlock Text="{Binding Count}" Margin="6,0,0,0" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" />
                    </StackPanel>
                </Button>

                <!-- 항목. Content 를 물리면 ContentPresenter 의 DataContext 가 항목이 되어
                     ListInput.ItemAt 이 여기서 항목을 찾는다 (기존 클릭 경로 그대로다) -->
                <ContentPresenter x:Name="Row" Content="{Binding Item}"
                                  ContentTemplate="{StaticResource DetailsRow}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter TargetName="Header" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══ 목록 뷰 (docs/DESIGN.md §2) — 항목 200×22, 가로 간격 12 ═══
             세로로 채우고 다음 열로 넘어간다. 그래서 합성 행 하나가 한 '열' 이다 (ADR-016). -->
        <DataTemplate x:Key="ListCell" DataType="{x:Type vm:FileItemViewModel}">
            <Border Style="{StaticResource ItemSelection}" Width="200" Height="22" Margin="0,0,12,0">
                <Border Style="{StaticResource ItemFocus}">
                    <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Style="{StaticResource ItemIcon}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ItemName}" Text="{Binding Name}"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBox Grid.Column="1" Style="{StaticResource ItemNameEditor}" Margin="6,0,0,0" />
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ListRow" DataType="{x:Type vm:RowViewModel}">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ListCell}" Focusable="False" />
        </DataTemplate>

        <!-- ═══ 타일 뷰 (docs/DESIGN.md §2) — 높이 56, 아이콘 32, 최소 폭 220 가변 ═══ -->
        <DataTemplate x:Key="TileCell" DataType="{x:Type vm:FileItemViewModel}">
            <Border Style="{StaticResource ItemSelection}" Height="56" Margin="0,2,8,2">
                <Border Style="{StaticResource ItemFocus}">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Style="{StaticResource ItemIcon}" Width="32" Height="32" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ItemName}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBox Style="{StaticResource ItemNameEditor}" HorizontalAlignment="Left" MinWidth="140" />
                            <TextBlock Text="{Binding TypeText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Text2Brush}" />
                            <TextBlock Text="{Binding SizeText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Text2Brush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>

        <!-- 칸 수를 행에서 받는다 — 항목 수로 나누면 두 칸뿐인 마지막 줄이 화면을 반씩 쓴다 -->
        <DataTemplate x:Key="TileRow" DataType="{x:Type vm:RowViewModel}">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileCell}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="{Binding Capacity}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- ═══ 큰 아이콘 뷰 (docs/DESIGN.md §2) — 항목 116×140, 썸네일 96, 이름 2줄 ═══ -->
        <DataTemplate x:Key="IconCell" DataType="{x:Type vm:FileItemViewModel}">
            <Border Style="{StaticResource ItemSelection}" Width="116" Height="140" Margin="0,4,8,4">
                <Border Style="{StaticResource ItemFocus}">
                    <StackPanel Margin="6" VerticalAlignment="Center">
                        <Image Style="{StaticResource ItemIcon}" Width="96" Height="96" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource ItemName}" Text="{Binding Name}" Width="104" Margin="0,4,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   LineHeight="14" LineStackingStrategy="BlockLineHeight" MaxHeight="28" />
                        <TextBox Style="{StaticResource ItemNameEditor}" Width="104" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="IconRow" DataType="{x:Type vm:RowViewModel}">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource IconCell}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- ═══ 목록 컨트롤 ═══
             가상화 필수 조합 (docs/ARCHITECTURE.md §5). 뷰 전환은 DataTemplate 교체이고
             (ADR-002) 컨트롤은 하나다. 뷰포트·보이는 범위는 패널이 민다 — 가상화 패널이
             스크롤 주인이라 그 크기가 곧 픽셀 뷰포트다. -->
        <ItemsPanelTemplate x:Key="VerticalItems">
            <VirtualizingStackPanel Orientation="Vertical"
                                    v:ViewportSync.Enabled="True"
                                    v:VisibleRangeSync.Enabled="True" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="HorizontalItems">
            <VirtualizingStackPanel Orientation="Horizontal"
                                    v:ViewportSync.Enabled="True"
                                    v:VisibleRangeSync.Enabled="True" />
        </ItemsPanelTemplate>

        <!-- 내장 선택·포커스를 쓰지 않는다 — 이동·선택은 ViewModel 이 한다 (ADR-016) -->
        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <!-- **명시해야 한다** (2026-08-12 · 다크에서 드러났다). ListBox 의 기본 Foreground 는
                 시스템 색(검정 계열)이고, 그것이 ContentPresenter 를 지나 항목 텍스트에
                 상속된다 — 자기 Foreground 를 지정하지 않은 TextBlock(ItemName)이 그것을
                 받는다. 라이트에서는 우연히 맞아 v1 부터 아무도 몰랐고, 다크에서 파일
                 이름이 배경에 묻혀서야 보였다. 트리는 TreeItemName 이 이미 명시하고 있었다 -->
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- 내장 type-ahead 를 끈다 — wrap 뷰에서 컨테이너는 항목이 아니라 행이라
                 (ADR-016) 엉뚱한 것을 고른다. 문자 키는 TypeAheadInput 이 받는다 -->
            <Setter Property="IsTextSearchEnabled" Value="False" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RowContainer}" />
            <Setter Property="ItemTemplate" Value="{StaticResource DetailsRow}" />
            <Setter Property="ItemsPanel" Value="{StaticResource VerticalItems}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
            <Style.Triggers>
                <!-- 그룹화를 켠 Details 만 헤더가 섞인 행을 쓴다 (docs/PRD-v2.md §6-1).
                     아래 뷰 모드 트리거들과 조건이 배타적이라 순서는 상관없다 -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ViewMode}" Value="Details" />
                        <Condition Binding="{Binding IsGrouped}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="ItemTemplate" Value="{StaticResource DetailsGroupedRow}" />
                </MultiDataTrigger>
                <!-- 목록 뷰만 가로 스크롤이다 — 세로로 채우고 다음 열로 넘어간다 (ADR-016) -->
                <DataTrigger Binding="{Binding ViewMode}" Value="List">
                    <Setter Property="ItemTemplate" Value="{StaticResource ListRow}" />
                    <Setter Property="ItemsPanel" Value="{StaticResource HorizontalItems}" />
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewMode}" Value="Tiles">
                    <Setter Property="ItemTemplate" Value="{StaticResource TileRow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewMode}" Value="LargeIcons">
                    <Setter Property="ItemTemplate" Value="{StaticResource IconRow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ 탭 (docs/DESIGN.md §1-1 · docs/PRD-v2.md §17) ═══ -->

        <!-- 탭 하나 — 높이 24 · 모서리 4,4,0,0 (아래로 툴바에 붙는다). 폭은 줄이 정한다
             (Views/TabStripPanel.cs: 최대 180 · 최소 90 균등 · 고정 28).
             Focusable=False 인 것은 전환 직후 포커스가 목록으로 가야 하기 때문이다
             (Views/TabFocus.cs) — 탭에 포커스가 남으면 방향키가 목록을 못 움직인다. -->
        <Style x:Key="TabChrome" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <!-- 활성 표시선의 색을 실어 나른다 — 비활성이면 투명이다. 템플릿 안의 요소는
                 Style 트리거가 TargetName 으로 못 건드리므로 (그것은 ControlTemplate.Triggers
                 의 몫이다) 속성 하나에 얹어 TemplateBinding 으로 내린다. 이 버튼은 테두리를
                 쓰지 않아 BorderBrush 가 비어 있다. -->
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4,4,0,0" Background="{TemplateBinding Background}">
                            <DockPanel>
                                <!-- 활성 탭 표시 — 위쪽 2px accent (docs/DESIGN.md §1-1).
                                     비활성일 때도 <b>자리는 차지한다</b>: 색만 투명이라
                                     전환할 때 글자가 2px 튀지 않는다. -->
                                <Border DockPanel.Dock="Top" Height="2" CornerRadius="2,2,0,0"
                                        Background="{TemplateBinding BorderBrush}" />
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 활성 탭 (docs/DESIGN.md §1-1 · 사용자 결정 2026-08-11).
                     **구분은 상단 accent 라인이 한다.** 배경만으로는 갈리지 않는다 —
                     pane-bg(#FFFFFF)와 활성 페인의 줄 배경 chrome-bg(#F9F9F9)의 차이가
                     6/255 뿐이다. 원래 pane-bg 를 고른 근거는 "목록과 같은 색이라 아래로
                     이어져 보인다" 였는데, 탭 아래에 오는 것은 목록이 아니라 툴바다.
                     라인은 §6 이 활성 페인에 쓰는 관용구와 같은 것이다.

                     탭은 자기가 활성인지 모른다: 그 상태의 소유자는 페인이고, 탭에 IsActive 를
                     따로 두면 진실이 둘이 된다. 그래서 인스턴스를 맞춰 본다 —
                     이름·폴더로는 가릴 수 없다 (같은 폴더를 여러 탭에 열 수 있다). -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource SameInstance}">
                            <Binding />
                            <Binding Path="DataContext.Active" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource PaneBgBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 닫기 16×16 (E8BB 8px). **항상 자리를 차지한다** — 호버할 때만 나타나게 하면
             제목 폭이 그때마다 흔들린다. 최소 폭 90 은 이 16 을 이미 포함한 값이다.
             고정 탭에는 없다 (먼저 고정을 풀어야 닫힌다 · docs/PRD-v2.md §17). -->
        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Content" Value="&#xE8BB;" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 마지막 탭과 고정 탭은 닫히지 않는다 — 누를 수 없는 버튼을 두는 대신
                     자리째 접는다 (docs/PRD-v2.md §17). -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 새 탭 24×24 (E710) — 줄 오른쪽 끝 고정이고 스크롤 영역 밖이다 -->
        <Style x:Key="TabAddButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ═══ 페인 하나 (좌우가 공유한다) ═══
             **크롬(테두리·모서리)은 이 템플릿에 없다** — 탭 줄과 이 페인을 함께 감싸는
             바깥 Border(PaneWithTabs)가 그린다. 여기 다시 두면 1px 이 둘이 되어 2px 로 보인다. -->
        <DataTemplate x:Key="PaneTemplate" DataType="{x:Type vm:PaneViewModel}">
            <!-- Ctrl+L·Alt+D 를 창이 아니라 여기서 받는다 — 키가 온 쪽이 곧 그 페인이다 -->
            <Border x:Name="PaneRoot" Background="{DynamicResource PaneBgBrush}"
                    v:AddressFocus.Enabled="True"
                    v:AddressFocus.IsEditing="{Binding IsAddressEditing, Mode=TwoWay}">
                <DockPanel>
                    <!-- 툴바 36 (docs/DESIGN.md §1·§7) -->
                    <Border x:Name="ToolbarChrome" DockPanel.Dock="Top" Height="36"
                            Background="{DynamicResource WinBgBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1">
                        <!-- 접기 배치 (phase 3 step 2·4). FoldOrder 1 은 비워 둔다 — 2구간의
                             외부 도구([VS]·[>_])가 가장 먼저 접히는 자리다. 구분자 Rectangle 은
                             뒤따르는 무리와 같은 번호다 — 아니면 구분자만 고아로 남는다. -->
                        <v:ToolbarOverflowPanel x:Name="PaneToolbar" Margin="6,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolButton}" Content="&#xE72B;" ToolTip="뒤로 (Alt+←)"
                                    Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" />
                            <Button Style="{StaticResource ToolButton}" Content="&#xE72A;" ToolTip="앞으로 (Alt+→)"
                                    Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" />
                            <Button Style="{StaticResource ToolButton}" Content="&#xE74A;" ToolTip="상위 폴더 (Alt+↑)"
                                    Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}" />
                            <Rectangle Width="1" Height="18" Margin="4,0" Fill="{DynamicResource StrokeStrongBrush}" />
                            <Button Style="{StaticResource ToolButton}" Content="&#xE72C;" ToolTip="새로 고침 (F5)"
                                    Command="{Binding RefreshCommand}" />
                            <Rectangle Width="1" Height="18" Margin="4,0" Fill="{DynamicResource StrokeStrongBrush}"
                                       v:ToolbarOverflowPanel.FoldOrder="3" />
                            <Button Style="{StaticResource ViewButton}" Content="&#xE8A4;" ToolTip="자세히 (Ctrl+Shift+1)"
                                    v:ToolbarOverflowPanel.FoldOrder="3"
                                    Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.Details}"
                                    Tag="{Binding ViewMode, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static state:ViewMode.Details}}" />
                            <Button Style="{StaticResource ViewButton}" Content="&#xE8FD;" ToolTip="목록 (Ctrl+Shift+2)"
                                    v:ToolbarOverflowPanel.FoldOrder="3"
                                    Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.List}"
                                    Tag="{Binding ViewMode, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static state:ViewMode.List}}" />
                            <Button Style="{StaticResource ViewButton}" Content="&#xE8A9;" ToolTip="타일 (Ctrl+Shift+3)"
                                    v:ToolbarOverflowPanel.FoldOrder="3"
                                    Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.Tiles}"
                                    Tag="{Binding ViewMode, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static state:ViewMode.Tiles}}" />
                            <!-- 큰 아이콘만 DESIGN §7 의 E8A6 이 아니다 — 그 자리는 잠긴 문서
                                 (ProtectedDocument) 글리프다. 큰 사각 하나로 바꿨다 -->
                            <Button Style="{StaticResource ViewButton}" Content="&#xE15B;" ToolTip="큰 아이콘 (Ctrl+Shift+4)"
                                    v:ToolbarOverflowPanel.FoldOrder="3"
                                    Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.LargeIcons}"
                                    Tag="{Binding ViewMode, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static state:ViewMode.LargeIcons}}" />

                            <!-- 분류 (docs/PRD-v2.md §6-1). 헤더 우클릭만 두었더니 찾을 수 없었다 —
                                 Menu/MenuItem 은 눌러서 펴지는 것이 내장이라 코드비하인드가 필요 없다.
                                 Details 전용이므로 다른 뷰에서는 비활성이다 -->
                            <Rectangle Width="1" Height="18" Margin="4,0" Fill="{DynamicResource StrokeStrongBrush}"
                                       v:ToolbarOverflowPanel.FoldOrder="2" />
                            <Menu Background="Transparent" VerticalAlignment="Center" Padding="0"
                                  v:ToolbarOverflowPanel.FoldOrder="2">
                                <MenuItem Style="{StaticResource ToolMenu}" Header="&#xE8EC;" ToolTip="분류 방법"
                                          ItemsSource="{Binding GroupOptions}"
                                          IsEnabled="{Binding ViewMode, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static state:ViewMode.Details}}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource GroupOptionItem}">
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.ChangeGroupCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                            </Menu>

                            <!-- 알려진 폴더 (phase 3). 글리프는 E707(MapPin) — E700 은 타이틀바
                                 트리 토글이 이미 쓰고, ☰ 는 DESIGN §7 이 금지한 선 계열이다
                                 (사용자 확정 2026-08-21). 절대 접히지 않고 오른쪽에 붙는다. -->
                            <Menu Background="Transparent" VerticalAlignment="Center" Padding="0"
                                  v:ToolbarOverflowPanel.AlignRight="True">
                                <MenuItem Style="{StaticResource ToolMenu}" Header="&#xE707;"
                                          AutomationProperties.Name="알려진 폴더" ToolTip="알려진 폴더"
                                          ItemsSource="{Binding KnownFolderOptions}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding Label}" />
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.OpenKnownFolderCommand,
                                                            RelativeSource={RelativeSource AncestorType=Menu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                            </Menu>

                            <!-- » 오버플로 머리 — 접힌 것이 있을 때만 패널이 보인다. 안의
                                 서브메뉴는 살아 있는 버튼을 옮긴 것이 아니라 두 벌째다
                                 (ToolbarOverflowPanel 주석) — Command 가 같은 ViewModel 을
                                 보므로 진실원천은 하나다. -->
                            <Menu Background="Transparent" VerticalAlignment="Center" Padding="0"
                                  v:ToolbarOverflowPanel.AlignRight="True"
                                  v:ToolbarOverflowPanel.IsOverflowHead="True">
                                <MenuItem Style="{StaticResource ToolMenu}" Header="&#x00BB;"
                                          AutomationProperties.Name="더 보기" ToolTip="더 보기">
                                    <MenuItem Header="보기 모드"
                                              Visibility="{Binding FoldedOrders, ElementName=PaneToolbar,
                                                           Converter={StaticResource FoldedOrderToVisibility},
                                                           ConverterParameter=3}">
                                        <MenuItem Header="자세히"
                                                  Command="{Binding ChangeViewModeCommand}"
                                                  CommandParameter="{x:Static state:ViewMode.Details}" />
                                        <MenuItem Header="목록"
                                                  Command="{Binding ChangeViewModeCommand}"
                                                  CommandParameter="{x:Static state:ViewMode.List}" />
                                        <MenuItem Header="타일"
                                                  Command="{Binding ChangeViewModeCommand}"
                                                  CommandParameter="{x:Static state:ViewMode.Tiles}" />
                                        <MenuItem Header="큰 아이콘"
                                                  Command="{Binding ChangeViewModeCommand}"
                                                  CommandParameter="{x:Static state:ViewMode.LargeIcons}" />
                                    </MenuItem>
                                    <MenuItem Header="분류 방법"
                                              ItemsSource="{Binding GroupOptions}"
                                              IsEnabled="{Binding ViewMode, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static state:ViewMode.Details}}"
                                              Visibility="{Binding FoldedOrders, ElementName=PaneToolbar,
                                                           Converter={StaticResource FoldedOrderToVisibility},
                                                           ConverterParameter=2}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource GroupOptionItem}">
                                                <Setter Property="Command"
                                                        Value="{Binding DataContext.ChangeGroupCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                </MenuItem>
                            </Menu>
                        </v:ToolbarOverflowPanel>
                    </Border>

                    <!-- 주소줄 28 · 입력 24 (docs/DESIGN.md §1) -->
                    <Border x:Name="AddrChrome" DockPanel.Dock="Top" Height="28"
                            Background="{DynamicResource WinBgBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1">
                        <Border x:Name="AddrBox" Height="24" Margin="6,0,6,4" CornerRadius="4"
                                Background="{DynamicResource PaneBgBrush}"
                                BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1">
                            <Grid>
                                <!-- breadcrumb (목업 .addr .seg / .chev). 기본은 이쪽이고
                                     편집 중에만 아래 TextBox 로 갈린다. 칸을 누르면 기존
                                     OpenAddressCommand 가 그대로 받는다 — 이동 경로를
                                     둘로 늘리지 않는다. -->
                                <ItemsControl ItemsSource="{Binding AddressSegments}"
                                              Margin="4,0,8,0" VerticalAlignment="Center"
                                              Background="Transparent"
                                              v:AddressFocus.IsCrumbs="True">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAddressEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 구분자는 칸 사이에만. 첫 칸은 IsFirst 로 걸러진다 -->
                                                <TextBlock Text="&#x203A;" Margin="1,0" VerticalAlignment="Center"
                                                           FontSize="10" Foreground="{DynamicResource Text2Brush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Style="{StaticResource CrumbButton}"
                                                        Content="{Binding Name}"
                                                        Command="{Binding DataContext.OpenAddressCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Path}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBox Text="{Binding AddressEdit, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" Margin="8,0,8,0"
                                         VerticalContentAlignment="Center"
                                         Foreground="{DynamicResource TextBrush}"
                                         v:AddressFocus.IsAddressBox="True">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAddressEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding OpenAddressCommand}"
                                                    CommandParameter="{Binding AddressEdit}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>
                        </Border>
                    </Border>

                    <Grid>
                        <DockPanel Margin="8,0">
                            <!-- Details 헤더 24 — 클릭 = 정렬 (탐색기와 같다). 다른 뷰에는 컬럼이 없다 -->
                            <Grid DockPanel.Dock="Top" Height="24"
                                  Visibility="{Binding ViewMode, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static state:ViewMode.Details}}"
                                  v:ColumnSync.Enabled="True"
                                  v:ColumnSync.NameWidth="{Binding NameColumnWidth, Mode=TwoWay}"
                                  v:ColumnSync.SizeWidth="{Binding SizeColumnWidth, Mode=TwoWay}"
                                  v:ColumnSync.TypeWidth="{Binding TypeColumnWidth, Mode=TwoWay}"
                                  v:ColumnSync.ModifiedWidth="{Binding ModifiedColumnWidth, Mode=TwoWay}">
                                <!-- 분류 방법 — 탐색기와 같은 자리(헤더 우클릭). 컬럼 사이 빈 틈에서만
                                     여기가 잡히고, 버튼 위에서는 HeaderButton 스타일의 같은 메뉴가 뜬다 -->
                                <Grid.ContextMenu>
                                    <StaticResource ResourceKey="GroupByMenu" />
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <!-- 폭은 ColumnSync 가 편다. 넷 다 픽셀이고 남는 자리는
                                         맨 뒤 빈 열이 먹는다 — 탐색기와 같은 모양이다.
                                         MinWidth 를 걸지 않는다: 손잡이가 하한을 이미 막고,
                                         걸면 ColumnSync 가 정한 폭과 다투게 된다. -->
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource HeaderButton}"
                                        Command="{Binding ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="이름" />
                                        <TextBlock Style="{StaticResource SortGlyph}"
                                                   Visibility="{Binding DataContext.Sort[0].Key, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static sorting:SortKey.Name}}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right"
                                        Command="{Binding ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Size}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="크기" />
                                        <TextBlock Style="{StaticResource SortGlyph}"
                                                   Visibility="{Binding DataContext.Sort[0].Key, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static sorting:SortKey.Size}}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource HeaderButton}"
                                        Command="{Binding ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Type}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="유형" />
                                        <TextBlock Style="{StaticResource SortGlyph}"
                                                   Visibility="{Binding DataContext.Sort[0].Key, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static sorting:SortKey.Type}}" />
                                    </StackPanel>
                                </Button>
                                <!-- 컬럼 경계. 각자 자기 열의 오른쪽 끝에 붙는다 — 끄는
                                     만큼 그 열만 넓어지고 좁아진다. 버튼보다 뒤에 선언해야
                                     위에 얹혀 마우스를 먼저 받는다. -->
                                <Thumb Grid.Column="0" Tag="Name" Style="{StaticResource ColumnGrip}" />
                                <Thumb Grid.Column="1" Tag="Size" Style="{StaticResource ColumnGrip}" />
                                <Thumb Grid.Column="2" Tag="Type" Style="{StaticResource ColumnGrip}" />
                                <Thumb Grid.Column="3" Tag="Modified" Style="{StaticResource ColumnGrip}" />

                                <Button Grid.Column="3" Style="{StaticResource HeaderButton}"
                                        Command="{Binding ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Modified}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="수정한 날짜" />
                                        <TextBlock Style="{StaticResource SortGlyph}"
                                                   Visibility="{Binding DataContext.Sort[0].Key, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static sorting:SortKey.Modified}}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 소스가 둘이다 — Details 는 평평한 Items, wrap 뷰 3종은 합성 행 (ADR-016) -->
                            <ListBox Style="{StaticResource PaneList}"
                                     v:TypeAheadInput.Enabled="True"
                                     v:TabFocus.Enabled="True"
                                     v:FocusScroll.FocusedName="{Binding FocusedName}"
                                     v:FocusScroll.RenamingName="{Binding RenamingName}"
                                     v:ListInput.SelectCommand="{Binding SelectItemCommand}"
                                     v:ListInput.ToggleCommand="{Binding ToggleItemCommand}"
                                     v:ListInput.RangeCommand="{Binding RangeSelectItemCommand}"
                                     v:ListInput.OpenCommand="{Binding ActivateCommand}"
                                     v:ListInput.EmptyCommand="{Binding ClickBackgroundCommand}"
                                     v:ListInput.RenameCommand="{Binding BeginRenameCommand}"
                                     v:ListInput.ContextMenuCommand="{Binding ShowContextMenuCommand}"
                                     v:DragDropInput.Enabled="True">
                                <ListBox.ItemsSource>
                                    <MultiBinding Converter="{StaticResource ViewSource}">
                                        <Binding Path="ViewMode" />
                                        <Binding Path="Items" />
                                        <Binding Path="Rows" />
                                        <Binding Path="DetailRows" />
                                    </MultiBinding>
                                </ListBox.ItemsSource>
                                <ListBox.InputBindings>
                                    <!-- 이동·선택 (docs/DESIGN.md §9) — 합성 행 위에서 내장 이동은 못 쓴다 -->
                                    <KeyBinding Key="Up" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Up}" />
                                    <KeyBinding Key="Down" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Down}" />
                                    <KeyBinding Key="Left" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Left}" />
                                    <KeyBinding Key="Right" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Right}" />
                                    <KeyBinding Key="Home" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Home}" />
                                    <KeyBinding Key="End" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.End}" />
                                    <KeyBinding Key="PageUp" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.PageUp}" />
                                    <KeyBinding Key="PageDown" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.PageDown}" />
                                    <KeyBinding Key="Up" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Up}" />
                                    <KeyBinding Key="Down" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Down}" />
                                    <KeyBinding Key="Left" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Left}" />
                                    <KeyBinding Key="Right" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Right}" />
                                    <KeyBinding Key="Home" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Home}" />
                                    <KeyBinding Key="End" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.End}" />
                                    <KeyBinding Key="PageUp" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.PageUp}" />
                                    <KeyBinding Key="PageDown" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.PageDown}" />
                                    <KeyBinding Key="Up" Modifiers="Control" Command="{Binding FocusOnlyToCommand}" CommandParameter="{x:Static vm:FocusMove.Up}" />
                                    <KeyBinding Key="Down" Modifiers="Control" Command="{Binding FocusOnlyToCommand}" CommandParameter="{x:Static vm:FocusMove.Down}" />
                                    <KeyBinding Key="Left" Modifiers="Control" Command="{Binding FocusOnlyToCommand}" CommandParameter="{x:Static vm:FocusMove.Left}" />
                                    <KeyBinding Key="Right" Modifiers="Control" Command="{Binding FocusOnlyToCommand}" CommandParameter="{x:Static vm:FocusMove.Right}" />
                                    <KeyBinding Key="Space" Modifiers="Control" Command="{Binding ToggleFocusedCommand}" />
                                    <KeyBinding Key="Return" Command="{Binding OpenFocusedCommand}" />
                                </ListBox.InputBindings>
                            </ListBox>
                        </DockPanel>

                        <!-- 빈 폴더 (docs/UI_GUIDE.md §상태 표현 · 목업 문구 그대로) -->
                        <TextBlock x:Name="EmptyMessage" Text="이 폴더는 비어 있습니다."
                                   HorizontalAlignment="Center" Margin="0,120,0,0"
                                   Foreground="{DynamicResource Text2Brush}" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Empty">
                    <Setter TargetName="EmptyMessage" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- 활성 페인 — 크롬 배경 승격 + 주소줄 accent (docs/DESIGN.md §6) -->
                <DataTrigger Binding="{Binding Path=(v:PaneChrome.IsActive), ElementName=PaneRoot}" Value="True">
                    <Setter TargetName="ToolbarChrome" Property="Background" Value="{DynamicResource ChromeBgBrush}" />
                    <Setter TargetName="AddrChrome" Property="Background" Value="{DynamicResource ChromeBgBrush}" />
                    <Setter TargetName="AddrBox" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="AddrBox" Property="BorderThickness" Value="1,1,1,2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══ 탭 줄 + 페인 (docs/DESIGN.md §1-1 · docs/PRD-v2.md §17) ═══
             페인마다 하나이고 페인 안 맨 위다 — 탭 줄 → 툴바 → 주소줄 → 목록.
             좌·우가 <b>각자</b> 갖는다: 탭 전환에 반대편이 함께 바뀌면 페인 간 복사의 대상이
             사라진다 (2분할의 존재 이유가 그 왕복이다).

             **탭 줄이 PaneTemplate 밖인 것은 수명 때문이다.** 활성 탭이 바뀌면 아래
             ContentControl 이 무는 PaneViewModel 이 바뀌어 페인 트리가 통째로 다시 선다 —
             줄을 그 안에 두면 지금 누르고 있는 그것이 매 전환마다 새로 서고, 가로 스크롤
             위치와 드래그 상태가 함께 사라진다. -->
        <DataTemplate x:Key="PaneWithTabs" DataType="{x:Type vm:PaneTabsViewModel}">
            <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="6,6,0,0" Background="{DynamicResource WinBgBrush}">
                <DockPanel>
                    <!-- 줄 28 = 탭 24 + 위 여백 4 (docs/DESIGN.md §1-1).
                         탭이 1개여도 접히지 않는다 — '+' 진입점이 늘 같은 자리에 있어야 하고,
                         줄이 생겼다 사라지면 목록이 위아래로 튄다. -->
                    <Border x:Name="StripChrome" DockPanel.Dock="Top" Height="28" Padding="6,4,4,0"
                            Background="{DynamicResource WinBgBrush}" CornerRadius="6,6,0,0">
                        <DockPanel>
                            <!-- 새 탭 — 줄 오른쪽 끝 고정이고 스크롤 영역 밖이다 -->
                            <!-- 글리프 버튼은 이름이 비어 UIA·화면 낭독기에 아무것도 주지
                                 않는다. 캡션 버튼과 달리 여기는 관용 이름조차 없다 -->
                            <Button DockPanel.Dock="Right" Style="{StaticResource TabAddButton}"
                                    Content="&#xE710;" ToolTip="새 탭 (Ctrl+T)"
                                    AutomationProperties.Name="새 탭"
                                    Command="{Binding AddTabCommand}" />

                            <!-- **ItemsSource 는 StripTabs 다. Tabs 가 아니다.**
                                 이유가 둘이다. (1) 고정 탭을 앞에 모으는 것이 그 속성이고,
                                 정렬을 여기서 다시 하면 같은 규칙이 두 계층으로 갈린다 —
                                 '오른쪽 탭 닫기' 가 보는 순서와 화면이 어긋난다
                                 (docs/PRD-v2.md §17 §값을 치르고 배운 것).
                                 (2) StripTabs 는 평범한 리스트라 <b>바인딩 엔진이 스레드를
                                 넘겨 준다</b>. 닫기·떼기는 감시를 놓느라 UI 스레드 밖에서
                                 목록을 건드리므로 (PaneTabsViewModel.CloseAsync), 여기에
                                 ObservableCollection 인 Tabs 를 물리면 CollectionView 가
                                 그 자리에서 던진다. -->
                            <!-- Tag 가 워크스페이스인 것은 탭 컨텍스트 메뉴 때문이다. 메뉴가
                                 손에 쥐는 것은 PlacementTarget(탭 버튼) 하나뿐이라 거기서
                                 셋을 다 꺼내야 하는데, 버튼의 자리는 DataContext(그 탭)와
                                 Tag(이 ItemsControl) 둘뿐이다 — 세 번째인 워크스페이스가
                                 여기 실린다 ('반대편 페인으로 보내기' 는 페인 둘을 알아야 한다). -->
                            <ItemsControl ItemsSource="{Binding StripTabs}" Focusable="False"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- 폭 나누기·가로 스크롤·삽입선은 이 패널이 한다
                                             (Views/TabStripPanel.cs). ScrollViewer 를 쓰지
                                             않는 이유는 그 파일 주석에 있다. -->
                                        <!-- ItemsPanelTemplate 안에서는 조상을 명시한다 —
                                             DataContext 상속에만 기대면 이 자리에서 조용히
                                             null 이 되고, 활성 탭이 스크롤로 끌려오지 않는 것이
                                             유일한 증상이라 화면만 봐서는 원인이 안 보인다. -->
                                        <v:TabStripPanel InsertionBrush="{DynamicResource AccentBrush}"
                                                         ActiveTab="{Binding DataContext.Active, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         v:TabStripInput.Enabled="True"
                                                         v:TabDragInput.Enabled="True">
                                            <v:TabStripPanel.Style>
                                                <Style TargetType="v:TabStripPanel">
                                                    <!-- 투명이라도 배경이 있어야 빈 자리가 마우스를
                                                         받는다 (빈 곳 더블클릭 = 새 탭 · 휠 = 가로).
                                                         Setter 로 두는 것은 아래 트리거가 이기려면
                                                         지역값이 아니어야 하기 때문이다. -->
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <!-- 반대편 페인에서 온 탭이 이 줄 위에 있다 —
                                                             페인을 건너간다는 것이 줄 단위로 보여야 한다 -->
                                                        <DataTrigger Value="True"
                                                                     Binding="{Binding Path=(v:TabDragInput.IsDropTarget), RelativeSource={RelativeSource Self}}">
                                                            <Setter Property="Background" Value="{DynamicResource SelBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </v:TabStripPanel.Style>
                                        </v:TabStripPanel>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PaneViewModel}">
                                        <!-- Tag 가 ItemsControl 인 것은 컨텍스트 메뉴 때문이다.
                                             메뉴는 시각 트리 밖이라 조상을 못 찾고 손에 쥐는 것이
                                             PlacementTarget(이 버튼) 하나뿐이라, 거기서 셋을 다
                                             꺼낸다: DataContext=이 탭 · Tag.DataContext=페인의 탭
                                             목록 · Tag.Tag=워크스페이스. -->
                                        <Button x:Name="TabChromeRoot"
                                                AutomationProperties.Name="{Binding Title}"
                                                Tag="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <!-- 툴팁은 전체 경로다 — 제목이 말줄임되거나 사용자가
                                                 바꿔 놓았을 때 어디인지 아는 길이 그것뿐이다.
                                                 아직 열지 않은 배경 탭은 경로가 없어 툴팁도 없다. -->
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TabChrome}">
                                                    <Setter Property="ToolTip" Value="{Binding AddressText}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AddressText}" Value="">
                                                            <Setter Property="ToolTip" Value="{x:Null}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>

                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="닫기"
                                                              Command="{Binding Tag.DataContext.CloseTabCommand}"
                                                              CommandParameter="{Binding DataContext}" />
                                                    <MenuItem Header="다른 탭 모두 닫기"
                                                              Command="{Binding Tag.DataContext.CloseOtherTabsCommand}"
                                                              CommandParameter="{Binding DataContext}" />
                                                    <MenuItem Header="오른쪽 탭 닫기"
                                                              Command="{Binding Tag.DataContext.CloseTabsToTheRightCommand}"
                                                              CommandParameter="{Binding DataContext}" />
                                                    <Separator />
                                                    <MenuItem Header="복제"
                                                              Command="{Binding Tag.DataContext.DuplicateTabCommand}"
                                                              CommandParameter="{Binding DataContext}" />
                                                    <!-- 체크 표시를 쓰지 않는다 — IsCheckable 인 항목은
                                                         클릭이 IsChecked 를 지역값으로 덮어써 바인딩이
                                                         끊긴다. 머리글이 다음 동작을 말하는 편이 낫다. -->
                                                    <MenuItem Command="{Binding Tag.DataContext.TogglePinOnTabCommand}"
                                                              CommandParameter="{Binding DataContext}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                <Setter Property="Header" Value="탭 고정" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsPinned}" Value="True">
                                                                        <Setter Property="Header" Value="탭 고정 해제" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                    </MenuItem>
                                                    <!-- 이름 바꾸기의 진입은 여기 하나뿐이다 (§17) -->
                                                    <MenuItem Header="이름 바꾸기"
                                                              Command="{Binding DataContext.BeginTitleRenameCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="다른 페인으로 보내기"
                                                              Command="{Binding Tag.Tag.SendTabToOtherPaneCommand}"
                                                              CommandParameter="{Binding DataContext}" />
                                                    <Separator />
                                                    <!-- 분할 (docs/PRD-v2.md §18 · 사용자 결정
                                                         2026-08-12: 탭 줄 우클릭). 넷이면
                                                         '여기서 분할' 이, 1분할이면 '이 페인
                                                         닫기' 가 접힌다 — 눌러도 아무 일이
                                                         없는 항목은 고장으로 보인다. -->
                                                    <MenuItem Header="여기서 분할"
                                                              Command="{Binding Tag.Tag.SplitOnceCommand}"
                                                              Visibility="{Binding Tag.Tag.CanSplit, Converter={StaticResource BoolToVisibility}}" />
                                                    <!-- 지목한 페인을 닫는다. 커맨드가 받는
                                                         것은 탭이 아니라 **탭 목록**이라
                                                         Tag(ItemsControl)의 DataContext 다. -->
                                                    <MenuItem Header="이 페인 닫기"
                                                              Command="{Binding Tag.Tag.ClosePaneCommand}"
                                                              CommandParameter="{Binding Tag.DataContext}"
                                                              Visibility="{Binding Tag.Tag.CanClosePane, Converter={StaticResource BoolToVisibility}}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>

                                            <!-- 안쪽 (좌→우): 패딩 8 · 아이콘 16 · 간격 6 · 제목 ·
                                                 간격 4 · 닫기 16 · 패딩 4 (docs/DESIGN.md §1-1) -->
                                            <DockPanel x:Name="TabBody" Margin="8,0,4,0">
                                                <Button x:Name="TabClose" DockPanel.Dock="Right"
                                                        Style="{StaticResource TabCloseButton}"
                                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                                        AutomationProperties.Name="탭 닫기"
                                                        ToolTip="탭 닫기 (Ctrl+W)"
                                                        Command="{Binding Tag.DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Button}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock x:Name="TabIcon" Text="&#xE8B7;"
                                                           FontFamily="Segoe Fluent Icons" FontSize="16"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock x:Name="TabTitle" Text="{Binding Title}"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <!-- 제목 편집 — 목록·트리와 같은 편집기다 -->
                                                <TextBox x:Name="TabTitleEditor" Margin="6,0,0,0"
                                                         VerticalContentAlignment="Center" FontSize="12"
                                                         BorderThickness="0" Padding="0" Visibility="Collapsed"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         v:RenameEditor.Enabled="True"
                                                         v:RenameEditor.CommitCommand="{Binding CommitTitleRenameCommand}"
                                                         v:RenameEditor.CancelCommand="{Binding CancelTitleRenameCommand}" />
                                            </DockPanel>
                                        </Button>

                                        <DataTemplate.Triggers>
                                            <!-- 고정 탭 — 폭 28 은 줄이 준다. 여기서는 아이콘만
                                                 남기고 가운데로 모은다 (docs/DESIGN.md §1-1).
                                                 닫기가 없는 것은 "먼저 고정을 풀어야 닫힌다" 이다. -->
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter TargetName="TabTitle" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="TabClose" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="TabBody" Property="Margin" Value="0" />
                                                <Setter TargetName="TabIcon" Property="HorizontalAlignment" Value="Center" />
                                            </DataTrigger>
                                            <!-- 마지막 탭은 닫히지 않는다 — 누를 수 없는 버튼을
                                                 두는 대신 자리째 접는다 (docs/PRD-v2.md §17) -->
                                            <DataTrigger Value="1"
                                                         Binding="{Binding DataContext.Tabs.Count, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Setter TargetName="TabClose" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTitleEditing}" Value="True">
                                                <Setter TargetName="TabTitle" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="TabTitleEditor" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <!-- 활성 탭 하나가 페인을 그린다. 바깥이 무는 것은 탭 목록이고
                         (PaneWithTabs) 여기서 그 안의 활성 탭으로 한 번 더 물린다 —
                         탭 줄이 탭보다 오래 살아야 하기 때문이다. -->
                    <ContentControl Content="{Binding Active}" Focusable="False"
                                    ContentTemplate="{StaticResource PaneTemplate}" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- 비활성 페인의 탭 줄은 크롬 배경 강등 규칙을 그대로 따른다 (docs/DESIGN.md §6).
                     활성일 때만 chrome-bg 로 올라간다 — 툴바·주소줄과 같은 수다. -->
                <DataTrigger Value="True"
                             Binding="{Binding Path=(v:PaneChrome.IsActive), RelativeSource={RelativeSource Self}}">
                    <Setter TargetName="StripChrome" Property="Background" Value="{DynamicResource ChromeBgBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── 폴더 트리 (docs/PRD-v2.md §10) ───────────────────────────────────
             확장 화살표를 TreeViewItem 내장 HasItems 가 아니라 노드의 CanExpand 에 묶기
             위해 템플릿을 새로 쓴다. 내장을 쓰면 자식을 미리 읽어 와야 화살표가 서는데,
             그 미리 읽기가 트리에 선 모든 노드에 대한 저장소 호출이다 (CLAUDE.md §3). -->
        <Style x:Key="TreeChevron" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock x:Name="Glyph" FontFamily="Segoe Fluent Icons" FontSize="8"
                                       Text="&#xE76C;" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text2Brush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 즐겨찾기인 항목과 아닌 항목의 메뉴가 다르다. 한 메뉴에 두고 IsFavorite 으로
             각 항목을 여닫는다 — ContextMenu 는 PlacementTarget 에서 DataContext(노드)를
             물려받고, 트리 자신은 그 Tag 로 닿는다.

             **아래 TreeNodeItem 보다 먼저 있어야 한다.** StaticResource 는 앞선 정의만
             찾으므로, 뒤에 두면 Setter 가 조용히 UnsetValue 를 받고 우클릭하는 순간
             프로세스가 죽는다 (2026-08-10 실물에서 밟았다 — 컴파일도 테스트도 통과한다).

             x:Shared="False" 도 쓰지 않는다. 메뉴는 한 번에 하나만 열리므로 공유해도 되고,
             위 GroupByMenu 가 그것을 쓰는 이유는 페인 둘에 각각 붙기 때문이다. -->
        <Style x:Key="PinMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FavoriteMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FavoriteSeparator" TargetType="Separator">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="TreeNodeMenu">
            <MenuItem Style="{StaticResource PinMenuItem}" Header="즐겨찾기에 추가"
                      Command="{Binding PlacementTarget.Tag.PinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Style="{StaticResource FavoriteMenuItem}" Header="이름 바꾸기"
                      Command="{Binding PlacementTarget.Tag.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Style="{StaticResource FavoriteMenuItem}" Header="위로"
                      Command="{Binding PlacementTarget.Tag.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Style="{StaticResource FavoriteMenuItem}" Header="아래로"
                      Command="{Binding PlacementTarget.Tag.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <Separator Style="{StaticResource FavoriteSeparator}" />
            <MenuItem Style="{StaticResource FavoriteMenuItem}" Header="즐겨찾기에서 제거"
                      Command="{Binding PlacementTarget.Tag.UnpinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
        </ContextMenu>

        <Style x:Key="TreeNodeItem" TargetType="TreeViewItem">
            <!-- 펼침·선택의 정본은 노드다. TreeView 의 SelectedItem 은 읽기 전용이라
                 바인딩으로 되돌릴 수 없어서, 컨테이너 쪽을 노드에 맞춘다. -->
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />

            <!-- 자식도 가상화한다. 노드마다 패널이 따로이므로 TreeView 에만 걸면 펼친
                 폴더의 항목 수만큼 컨테이너가 산다. 파생 패널인 이유는 TreeScroll 이
                 BringIndexIntoView 를 불러야 하기 때문이다 (protected 라 밖으로 연다). -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <v:RealizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>

            <!-- 이것이 없으면 자동화가 노드 이름을 ToString() 으로 읽어 클래스 이름을 낸다
                 (2026-08-10 UIA 로 확인). 헤더가 TextBlock 이라 자동으로 잡히지 않는다. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />

            <!-- 메뉴와 편집기가 트리의 커맨드에 닿는 통로. ContextMenu 는 비주얼 트리 밖이라
                 RelativeSource 로는 트리를 찾을 수 없다. -->
            <Setter Property="Tag"
                    Value="{Binding DataContext.Tree, RelativeSource={RelativeSource AncestorType=TreeView}}" />
            <Setter Property="ContextMenu" Value="{StaticResource TreeNodeMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Row" Height="24" CornerRadius="4" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="Chevron" Style="{StaticResource TreeChevron}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                                    <!-- 드라이브·서버·폴더가 같은 글리프다. 무엇인지는 라벨이
                                         말한다 ("로컬 디스크 (C:)" · "\\10.10.10.23") — 유형별
                                         아이콘을 붙이려면 shell 에 물어야 하고 그것은 노드마다
                                         저장소 호출이다. 즐겨찾기만 갈라 둔다: 그것은 내가
                                         만든 것이라 시스템이 주는 것과 섞이면 안 된다. -->
                                    <TextBlock x:Name="Glyph" Grid.Column="1"
                                               FontFamily="Segoe Fluent Icons" FontSize="12"
                                               Text="&#xE8B7;" Margin="2,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text2Brush}" />

                                    <ContentPresenter Grid.Column="2" ContentSource="Header" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 들여쓰기는 중첩마다 누적된다 (자식도 같은 템플릿을 쓴다). -->
                            <ItemsPresenter x:Name="Items" Margin="16,0,0,0" />
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                            </Trigger>

                            <!-- 열어 봤더니 하위 폴더가 없었다. 화살표를 남기면 눌러도 아무
                                 일이 없다. Hidden 이라 자리는 남는다 — 형제 이름이 들쭉날쭉
                                 시작하면 훑기 어렵다. -->
                            <DataTrigger Binding="{Binding CanExpand}" Value="False">
                                <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                            </DataTrigger>

                            <!-- 네트워크는 눈으로 갈린다. 펼치는 값이 다르기 때문이다 —
                                 로컬 폴더는 즉시 열리지만 이쪽은 서버가 죽어 있으면 수십
                                 초다 (docs/PRD-v2.md §5 N-4). 무엇을 누르는지 알고 눌러야
                                 한다. 아래 즐겨찾기 트리거보다 먼저 와야 별이 이긴다. -->
                            <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE704;" />
                            </DataTrigger>

                            <!-- 서버는 그 아래가 폴더가 아니라 공유 목록이라 한 겹 더 다르다. -->
                            <DataTrigger Binding="{Binding Location.IsNetworkServer}" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE968;" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE735;" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 즐겨찾기 이름 편집. 목록과 같은 편집기를 쓴다 (Views/RenameEditor.cs) —
             Enter·Esc·포커스 상실이 두 곳에서 다르게 동작할 이유가 없다. -->
        <Style x:Key="TreeItemName" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TreeItemNameEditor" TargetType="TextBox">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PaneBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="v:RenameEditor.Enabled" Value="True" />

            <!-- 커맨드는 트리가 갖는다. 컨테이너의 Tag 가 그 트리다 (아래 TreeNodeItem). -->
            <Setter Property="v:RenameEditor.CommitCommand"
                    Value="{Binding Tag.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
            <Setter Property="v:RenameEditor.CancelCommand"
                    Value="{Binding Tag.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
            <Grid>
                <TextBlock Style="{StaticResource TreeItemName}" Text="{Binding Label}" />
                <TextBox Style="{StaticResource TreeItemNameEditor}"
                         Text="{Binding EditingLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </HierarchicalDataTemplate>

        <!-- ═══ 설정 패널 (docs/PRD-v2.md §12) ═══
             여기 있는 것은 전부 이 패널 전용이라 파일 끝에 모아 둔다. StaticResource 는
             자기보다 앞선 정의만 찾으므로 (2026-08-10 에 값을 치르고 배운 것), 위의 색
             토큰만 참조하고 아래를 가리키지 않는다. -->

        <!-- 절 제목. 항목 사이를 가르는 것은 선이 아니라 이 간격이다. -->
        <Style x:Key="SettingsHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- 곁들이는 설명·결과 문구. 본문보다 작고 흐리다. -->
        <Style x:Key="SettingsNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsChoice" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SettingsToggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <!-- 패널 안의 누름 버튼. 툴바 버튼은 아이콘 전용이라 글자가 들어가지 않는다. -->
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ChromeBgBrush}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 시작 폴더 입력. 주소줄과 같은 계열이되 폭이 패널에 맞춰 늘어난다. -->
        <Style x:Key="SettingsPathBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PaneBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <!-- 업데이트 알림. 받아 둔 것이 없으면 접혀서 자리를 차지하지 않는다. -->
            <RowDefinition Height="Auto" />
            <!-- 사고 알림. 위와 같이 접히고, 둘이 함께 뜰 수 있다. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- 타이틀바 32 (docs/DESIGN.md §1 · 목업 .titlebar). 배경을 따로 칠하지 않는다 —
             창 배경이 그대로 보여야 크롬이 한 덩어리로 읽힌다. -->
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- 트리 토글은 페인 툴바가 아니라 여기 있다 — 트리는 창에 하나이고,
                     페인 툴바에 두면 같은 버튼이 둘이 된다 (docs/PRD-v2.md §10). -->
                <Button Style="{StaticResource ToolButton}" Content="&#xE700;" Margin="6,0,0,0"
                        ToolTip="폴더 트리" Command="{Binding ToggleTreeCommand}" />

                <!-- 활성 페인이 보고 있는 폴더를 고정한다 (docs/PRD-v2.md §10-2).
                     트리 조작이라 트리 토글 옆이다 — 페인 툴바에 두면 버튼이 둘이 된다. -->
                <Button Style="{StaticResource ToolButton}" Content="&#xE735;"
                        ToolTip="현재 폴더를 즐겨찾기에 추가" Command="{Binding PinCurrentFolderCommand}" />

                <!-- 분할 (docs/PRD-v2.md §18 · 사용자 결정 2026-08-12: 툴바 버튼).
                     트리 토글·즐겨찾기와 같은 자리인 이유도 같다 — 분할은 창 전체에 걸리고,
                     페인 툴바에 두면 같은 버튼이 페인 수만큼 생긴다.

                     **단축키는 없다** (사용자 결정 2026-08-12). Ctrl+1~4 는 정렬 키가,
                     Ctrl+Shift+1~4 는 보기 모드가 이미 쓴다 — 실제로 써 보고 고른다.

                     버튼 넷이 아니라 메뉴인 이유: 지금 몇 분할인지를 체크 표시로 말할 수
                     있고 (분류 메뉴와 같은 수), 글리프 넷을 새로 고르지 않아도 된다. -->
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Style="{StaticResource ToolMenu}" Header="&#xE8A9;"
                              AutomationProperties.Name="분할" ToolTip="분할"
                              ItemsSource="{Binding SplitOptions}"
                              ItemContainerStyle="{StaticResource SplitOptionItem}" />
                </Menu>

                <!-- 설정 (docs/PRD-v2.md §12). 창 전체에 걸리는 것이라 페인 툴바가 아니라
                     여기다 — 트리 토글·즐겨찾기와 같은 판단이다. E713 은 톱니 실루엣이고
                     옆의 둘(선 E700 · 별 E735)과 계열이 겹치지 않는다 (docs/DESIGN.md §7). -->
                <!-- AutomationProperties.Name 이 없으면 UIA 에 글리프 문자가 이름으로 잡힌다
                     — 트리 노드가 클래스 이름으로 잡히던 것과 같은 자리다 (§10). -->
                <Button Style="{StaticResource ToolButton}" Content="&#xE713;"
                        AutomationProperties.Name="설정"
                        ToolTip="설정" Command="{Binding OpenSettingsCommand}" />
                <TextBlock Text="flex-dir" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" />
            </StackPanel>

            <!-- 캡션 위에 놓인 것은 OS 가 먼저 가져간다. 버튼만 다시 꺼내 온다 —
                 이것이 없으면 눌러도 창이 끌린다. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        Command="{x:Static SystemCommands.MinimizeWindowCommand}" />
                <Button Style="{StaticResource MaximizeButton}"
                        Command="{x:Static SystemCommands.MaximizeWindowCommand}" />
                <Button Style="{StaticResource CloseButton}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}" />
            </StackPanel>
        </Grid>

        <!-- 트리 + 페인 둘 (docs/PRD-v2.md §10 · 사용자 결정 2026-08-10: 창 왼쪽에 하나).
             접으면 트리 열과 그 스플리터가 통째로 0 이 된다 — Visibility 만으로는 빈 띠가
             남아 되찾으려던 가로 공간이 그대로 없다 (TreeSync). -->
        <Grid Grid.Row="1" Margin="4,0,4,0"
              v:TreeSync.Enabled="True"
              v:TreeSync.Width="{Binding Tree.Width, Mode=TwoWay}"
              v:TreeSync.Visible="{Binding Tree.IsVisible}">
            <Grid.ColumnDefinitions>
                <!-- MinWidth 를 걸지 않는다 — 걸면 접을 때 0 으로 못 간다. 하한은 ViewModel
                     이 자르고(FolderTreeViewModel.Width) 놓는 순간 스냅한다. -->
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="646" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource PaneBgBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="6,6,0,0">
                <!-- 가상화를 명시한다. TreeView 의 기본 패널은 StackPanel 이라 그대로 두면
                     펼친 폴더의 항목 수만큼 컨테이너가 산다 (ADR-016 이 지킨 축). -->
                <!-- TreeScroll.Path 는 트리가 따라간 경로다 (docs/PRD-v2.md §10-3).
                     프로그램이 정한 선택으로는 TreeView 가 스크롤하지 않고, 가상화 때문에
                     화면 밖 노드는 컨테이너조차 없어 루트부터 실현하며 내려가야 한다. -->
                <!-- 가로 스크롤을 끈다 (사용자 결정 2026-08-12). 탐색기 탐색창에도 없다.
                     Hidden 이 아니라 Disabled 인 이유: Hidden 은 막대만 감출 뿐 내용을 여전히
                     무한 폭으로 재서, 따라가기의 BringIntoView (TreeScroll) 가 깊은 노드를
                     가로로 밀고 사용자는 되돌릴 수단이 없다. Disabled 는 내용을 뷰포트 폭에
                     묶어 밀 곳 자체를 없앤다 — 긴 이름은 라벨의 CharacterEllipsis 가 받는다. -->
                <TreeView ItemsSource="{Binding Tree.Roots}"
                          ItemContainerStyle="{StaticResource TreeNodeItem}"
                          v:FavoriteDropInput.Enabled="True"
                          v:TreeScroll.Path="{Binding Tree.RevealedPath}"
                          Background="Transparent" BorderThickness="0" Padding="4"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <v:RealizingStackPanel />
                        </ItemsPanelTemplate>
                    </TreeView.ItemsPanel>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" Focusable="False">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

        <!-- 페인 하나~넷 + 스플리터 6 (docs/DESIGN.md §1 · docs/PRD-v2.md §18). 비율 둘은
             복원·저장 대상이다. 위 여백이 0 인 것은 목업 .panes 그대로다 — 페인의 둥근 위
             모서리가 타이틀바에 붙어야 크롬이 이어져 보인다.

             **열·행 정의는 분할 수와 무관하게 고정이다.** 바뀌는 것은 자식이 어느 칸을
             차지하는가뿐이고 (v:SplitLayout), 정의를 갈아 끼우면 그때마다 페인이 통째로
             다시 그려져 스크롤과 선택 표시가 튄다. -->
        <Grid Grid.Column="2"
              v:SplitterSync.Enabled="True"
              v:SplitterSync.Ratio="{Binding SplitterRatio, Mode=TwoWay}"
              v:SplitterSync.RowRatio="{Binding RowRatio, Mode=TwoWay}"
              v:SplitLayout.Count="{Binding SplitCount}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <!-- 행 최소 높이가 열(320)보다 훨씬 작다. 목록은 세로로 좁아도 쓸 수 있고,
                 여기를 크게 잡으면 창 최소 높이가 그만큼 밀려 올라간다. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <!-- 무는 것이 활성 탭이 아니라 <b>탭 목록</b>이다 — 탭 줄이 탭보다 오래 살아야
                 하기 때문이다 (PaneWithTabs 주석). PaneTemplate 은 그 안쪽 ContentControl 이
                 활성 탭으로 다시 물리므로 템플릿 안 바인딩은 그대로다.

                 슬롯을 Panes[n] 이 아니라 속성 넷으로 무는 이유는 WorkspaceViewModel.Pane0
                 주석에 있다 — 인덱서 바인딩은 목록이 짧을 때 조용히 실패한다.

                 Grid.Row·Column 을 여기 적지 않는다. 그것은 SplitLayout 이 정하고, 여기 적으면
                 분할 수에 따라 달라지는 값이 두 곳에 생긴다. -->
            <!-- 활성 표시는 <b>같은 인스턴스인가</b>로 가른다 (SameInstanceConverter) —
                 번호로 가르면 페인을 닫을 때 맨 뒤와 자리를 맞바꾸는 순간
                 (WorkspaceViewModel.ClosePane) 표시가 엉뚱한 칸에 남는다. 탭 줄이 활성 탭을
                 가리는 것과 완전히 같은 수다. -->
            <ContentControl v:SplitLayout.Part="Pane0"
                            Content="{Binding Pane0}" ContentTemplate="{StaticResource PaneWithTabs}"
                            Focusable="False">
                <v:PaneChrome.IsActive>
                    <MultiBinding Converter="{StaticResource SameInstance}">
                        <Binding Path="Pane0" />
                        <Binding Path="ActivePane" />
                    </MultiBinding>
                </v:PaneChrome.IsActive>
            </ContentControl>
            <ContentControl v:SplitLayout.Part="Pane1"
                            Content="{Binding Pane1}" ContentTemplate="{StaticResource PaneWithTabs}"
                            Focusable="False">
                <v:PaneChrome.IsActive>
                    <MultiBinding Converter="{StaticResource SameInstance}">
                        <Binding Path="Pane1" />
                        <Binding Path="ActivePane" />
                    </MultiBinding>
                </v:PaneChrome.IsActive>
            </ContentControl>
            <ContentControl v:SplitLayout.Part="Pane2"
                            Content="{Binding Pane2}" ContentTemplate="{StaticResource PaneWithTabs}"
                            Focusable="False">
                <v:PaneChrome.IsActive>
                    <MultiBinding Converter="{StaticResource SameInstance}">
                        <Binding Path="Pane2" />
                        <Binding Path="ActivePane" />
                    </MultiBinding>
                </v:PaneChrome.IsActive>
            </ContentControl>
            <ContentControl v:SplitLayout.Part="Pane3"
                            Content="{Binding Pane3}" ContentTemplate="{StaticResource PaneWithTabs}"
                            Focusable="False">
                <v:PaneChrome.IsActive>
                    <MultiBinding Converter="{StaticResource SameInstance}">
                        <Binding Path="Pane3" />
                        <Binding Path="ActivePane" />
                    </MultiBinding>
                </v:PaneChrome.IsActive>
            </ContentControl>

            <!-- ResizeDirection 을 명시한다. Auto 면 SplitterSync 가 어느 비율을 되쓸지
                 판정할 수 없고, 짐작하면 세로로 끈 것이 열 비율을 덮어쓴다. -->
            <GridSplitter v:SplitLayout.Part="ColumnSplitter" ResizeDirection="Columns"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" Focusable="False"
                          Style="{StaticResource PaneSplitter}" />
            <GridSplitter v:SplitLayout.Part="RowSplitter" ResizeDirection="Rows"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" Focusable="False"
                          Style="{StaticResource PaneSplitter}" />
        </Grid>
        </Grid>

        <!-- 새 버전 알림 (docs/PRD-v2.md §9 · 사용자 결정 2026-08-07: 뜨고 사용자가 고른다).
             상태표시줄 바로 위다 — 목록을 밀어내지만 가리지는 않는다. 받아 둔 뒤에만 뜨므로
             '지금 설치' 는 곧바로 적용된다. -->
        <Border Grid.Row="2" Background="{DynamicResource SelBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0"
                Padding="12,6"
                Visibility="{Binding Update.IsAvailable, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}">
                    <Run Text="새 버전" />
                    <Run Text="{Binding Update.Version, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="이 준비됐습니다." />
                </TextBlock>

                <!-- '나중에' 가 오른쪽 끝이다. 파괴적이지 않은 쪽을 바깥에 두어 실수로
                     재시작되는 것을 막는다 — 트레이 메뉴의 구분선과 같은 판단이다. -->
                <Button DockPanel.Dock="Right" Style="{StaticResource CrumbButton}"
                        Content="나중에" Command="{Binding Update.DismissCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource CrumbButton}"
                        Content="지금 설치" Command="{Binding Update.InstallCommand}" />
            </DockPanel>
        </Border>

        <!-- 사고 알림 (docs/PRD-v2.md §14 · 사용자 결정 2026-08-11: 알림 바).
             업데이트 알림 바로 아래, 상태표시줄 바로 위다 — 오류 문구가 이미 사는 자리
             옆이라 눈이 가는 곳이 하나로 모인다.

             크롬은 업데이트 알림과 같고 글자만 ErrorBrush 다. 배경 토큰을 새로 만들지
             않는 이유: docs/DESIGN.md §5 는 그 색을 '오류 텍스트' 로 정의한다. 같은 종류의
             바인데 심각도만 다르다는 것이 이 모양으로 읽혀야 한다. -->
        <Border Grid.Row="3" Background="{DynamicResource SelBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0"
                Padding="12,6"
                Visibility="{Binding Crash.IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <DockPanel LastChildFill="False">
                <!-- 한 줄로 잘린다. 문구가 길어져 바가 두 줄이 되면 목록이 그만큼 밀린다 —
                     자세한 것은 error.log 에 있고 바는 그리로 가리키기만 한다. -->
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="{Binding Crash.Message}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ErrorBrush}" />

                <Button DockPanel.Dock="Right" Style="{StaticResource CrumbButton}"
                        Content="닫기" Command="{Binding Crash.DismissCommand}" />
            </DockPanel>
        </Border>

        <!-- 상태표시줄 24 — 활성 페인의 문구 (docs/DESIGN.md §1·§6) -->
        <Border Grid.Row="4" Background="{DynamicResource WinBgBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
          <Grid>
            <!-- 여유 용량은 오른쪽 끝이다 (목업 .free 의 margin-left:auto). 활성 페인의
                 드라이브이고, 모르면 빈 문자열이라 자리가 조용히 비워진다. 겹쳐 두는 것이
                 의도다 — 왼쪽 문구가 길어지면 밀려나는 대신 뒤로 지나간다. -->
            <TextBlock Text="{Binding ActivePane.FreeSpaceText}" Margin="12,0" FontSize="11"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text2Brush}" />

            <TextBlock Text="{Binding ActivePane.StatusText}" Margin="12,0" VerticalAlignment="Center" FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActivePane.Status}" Value="Error">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>

        <!-- ═══ 설정 패널 (docs/PRD-v2.md §12 · 사용자 결정 2026-08-10: 창 안 오버레이) ═══

             별도 Window 가 아니다. 상주 프로세스에서 창 닫기는 숨기기이므로 (ADR-003)
             별도 창을 두면 "주 창이 숨을 때 설정 창은 어떻게 되나" 가 그대로 새 결정이 된다.

             타이틀바(0행)는 덮지 않는다 — 창을 옮기고 닫는 길이 설정 중에도 살아 있어야 한다.
             마지막 자식이라 나머지 위에 그려진다 (Grid 의 z 순서는 문서 순서다).

             FallbackValue 가 있어야 한다: Settings 가 배선되지 않은 조립에서는 바인딩이
             UnsetValue 를 내고, 그러면 변환기가 아예 불리지 않아 Visibility 가 기본값
             (Visible)로 남는다 — 설정 없이 조립한 창이 설정 패널에 덮인다. -->
        <Grid Grid.Row="1" Grid.RowSpan="4"
              Visibility="{Binding Settings.IsOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">

            <!-- 바깥을 눌러도 닫힌다. Button 인 이유는 코드비하인드 없이 클릭을 받는 길이
                 그것뿐이기 때문이다 (CLAUDE.md §2). -->
            <Button Command="{Binding Settings.CloseCommand}" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#40000000" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource WinBgBrush}"
                    BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20,16">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Left" Text="설정" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                                Content="&#xE8BB;" FontSize="12"
                                Command="{Binding Settings.CloseCommand}" />
                    </DockPanel>

                    <!-- ── 정보 ─────────────────────────────────────────── -->
                    <TextBlock Style="{StaticResource SettingsHeading}" Text="정보" />

                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}">
                            <Run Text="버전" />
                            <Run Text="{Binding Settings.Version, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SettingsButton}"
                                Content="업데이트 확인"
                                Command="{Binding Settings.CheckUpdateCommand}" />
                    </DockPanel>

                    <!-- 누르기 전에는 비어 있다. 빈 문자열일 때 자리까지 접어야 버튼과
                         아래 항목 사이가 벌어지지 않는다. -->
                    <TextBlock Text="{Binding Settings.UpdateStatus}" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsNote}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.UpdateStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Style="{StaticResource SettingsButton}" HorizontalAlignment="Left"
                            Content="상태 폴더 열기"
                            Command="{Binding Settings.OpenStateFolderCommand}" />
                    <TextBlock Style="{StaticResource SettingsNote}" Margin="0,4,0,0"
                               Text="{Binding Settings.StateFolderText}" />

                    <Separator Margin="0,16" Background="{DynamicResource StrokeBrush}" />

                    <!-- ── 테마 (docs/PRD-v2.md §19) ───────────────────── -->
                    <TextBlock Style="{StaticResource SettingsHeading}" Text="테마" />

                    <RadioButton Style="{StaticResource SettingsChoice}" GroupName="Theme"
                                 Content="시스템 설정 사용"
                                 IsChecked="{Binding Settings.IsSystemTheme, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource SettingsChoice}" GroupName="Theme"
                                 Content="라이트"
                                 IsChecked="{Binding Settings.IsLightTheme, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource SettingsChoice}" GroupName="Theme"
                                 Content="다크"
                                 IsChecked="{Binding Settings.IsDarkTheme, Mode=TwoWay}" />

                    <Separator Margin="0,16" Background="{DynamicResource StrokeBrush}" />

                    <!-- ── 시작 폴더 ────────────────────────────────────── -->
                    <TextBlock Style="{StaticResource SettingsHeading}" Text="시작 폴더" />

                    <RadioButton Style="{StaticResource SettingsChoice}" GroupName="StartFolder"
                                 Content="마지막에 보던 폴더"
                                 IsChecked="{Binding Settings.StartsAtLastFolder, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource SettingsChoice}" GroupName="StartFolder"
                                 Content="정해 둔 폴더"
                                 IsChecked="{Binding Settings.StartsAtFixedFolder, Mode=TwoWay}" />

                    <Grid Margin="20,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- '마지막 폴더' 를 고른 동안 상자만 잠근다 — 고칠 수 있는데 아무
                             효과가 없으면 고쳐 놓고 왜 안 되는지 찾게 된다.

                             버튼은 잠그지 않는다. '현재 폴더로' 는 그 자체가 "여기서
                             시작하겠다" 라서 모드까지 바꾸는데 (SettingsViewModel), 버튼을
                             함께 잠그면 그 경로에 화면에서 닿을 수가 없다 — 라디오를 먼저
                             고르고 나서야 누를 수 있는 2단계가 된다.

                             기본 UpdateSourceTrigger(LostFocus)를 그대로 쓴다 — 글자마다
                             바꾸면 치는 도중의 반쪽 경로가 매번 저장된다. -->
                        <TextBox Style="{StaticResource SettingsPathBox}"
                                 IsEnabled="{Binding Settings.StartsAtFixedFolder}"
                                 Text="{Binding Settings.StartFolderText, Mode=TwoWay}" />

                        <Button Grid.Column="1" Style="{StaticResource SettingsButton}" Margin="6,0,0,0"
                                Content="현재 폴더로"
                                Command="{Binding UseCurrentFolderAsStartCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding Settings.StartFolderError}" Margin="20,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsNote}">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.StartFolderError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Separator Margin="0,16" Background="{DynamicResource StrokeBrush}" />

                    <!-- ── 숨김·시스템 파일 ─────────────────────────────── -->
                    <CheckBox Style="{StaticResource SettingsToggle}"
                              Content="숨김·시스템 파일 보기"
                              IsChecked="{Binding Settings.ShowHiddenItems, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource SettingsNote}" Margin="0,4,0,0"
                               Text="켜면 $Recycle.Bin · System Volume Information · desktop.ini 처럼 평소 감춰진 것이 목록과 트리에 함께 나옵니다." />

                    <Button Style="{StaticResource SettingsButton}" HorizontalAlignment="Right"
                            Margin="0,20,0,0" Content="닫기"
                            Command="{Binding Settings.CloseCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
