<Window x:Class="FlexDir.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FlexDir.App.Views"
        xmlns:vm="clr-namespace:FlexDir.App.ViewModels"
        xmlns:sorting="clr-namespace:FlexDir.Core.Sorting;assembly=FlexDir.Core"
        xmlns:state="clr-namespace:FlexDir.Core.ViewState;assembly=FlexDir.Core"
        Title="flex-dir"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="#F3F3F3"
        Foreground="#1B1B1B">

    <!-- 수치·색은 전부 docs/DESIGN.md §1~§7 이 정본이다. 색은 아래 리소스 사전이 정의하고,
         루트 attribute 둘(창 배경·전경)만 파서 순서 때문에 값을 직접 쓴다 — 같은 §5 값이다. -->

    <!-- ═══ 키보드 맵 — 창 전역 (docs/DESIGN.md §9) ═══
         방향·Enter 류는 페인 목록에 있다. 여기는 포커스와 무관한 전역 키만 둔다. -->
    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding ActivePane.GoBackCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ActivePane.GoForwardCommand}" />
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding ActivePane.GoUpCommand}" />
        <KeyBinding Key="F5" Command="{Binding ActivePane.RefreshCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding ActivePane.CopySelectionCommand}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding ActivePane.CutSelectionCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding ActivePane.PasteCommand}" />
        <KeyBinding Key="Delete" Command="{Binding ActivePane.DeleteSelectionCommand}" />
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding ActivePane.CreateFolderCommand}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding ActivePane.SelectAllCommand}" />
        <KeyBinding Key="Tab" Command="{Binding SwitchPaneCommand}" />
        <KeyBinding Key="F6" Command="{Binding SwitchPaneCommand}" />
        <KeyBinding Key="C" Modifiers="Control+Alt" Command="{Binding CopyToOtherPaneCommand}" />
        <KeyBinding Key="M" Modifiers="Control+Alt" Command="{Binding MoveToOtherPaneCommand}" />
        <KeyBinding Key="O" Modifiers="Control+Alt" Command="{Binding OpenOtherPaneLocationCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ActivePane.ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Name}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ActivePane.ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Size}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ActivePane.ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Type}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding ActivePane.ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Modified}" />
        <!-- 뷰 4종. 탐색기는 Ctrl+Shift+1~8 이지만 우리 뷰는 4종이라 툴바 버튼 순서에 맞춘다 -->
        <KeyBinding Key="D1" Modifiers="Control+Shift" Command="{Binding ActivePane.ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.Details}" />
        <KeyBinding Key="D2" Modifiers="Control+Shift" Command="{Binding ActivePane.ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.List}" />
        <KeyBinding Key="D3" Modifiers="Control+Shift" Command="{Binding ActivePane.ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.Tiles}" />
        <KeyBinding Key="D4" Modifiers="Control+Shift" Command="{Binding ActivePane.ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.LargeIcons}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- ═══ 색 토큰 (docs/DESIGN.md §5) ═══ -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
        <SolidColorBrush x:Key="WinBgBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="ChromeBgBrush" Color="#F9F9F9" />
        <SolidColorBrush x:Key="PaneBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B" />
        <SolidColorBrush x:Key="Text2Brush" Color="#616161" />
        <SolidColorBrush x:Key="TextDisabledBrush" Color="#9D9D9D" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#E5E5E5" />
        <SolidColorBrush x:Key="StrokeStrongBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="HoverBrush" Color="#0C000000" />
        <SolidColorBrush x:Key="PressedBrush" Color="#14000000" />
        <SolidColorBrush x:Key="SelBrush" Color="#240067C0" />
        <SolidColorBrush x:Key="SelHoverBrush" Color="#330067C0" />
        <SolidColorBrush x:Key="SelInactiveBrush" Color="#12000000" />
        <SolidColorBrush x:Key="FocusRingBrush" Color="#1B1B1B" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />

        <v:NameMembershipConverter x:Key="NameMembership" />
        <v:NameEqualityConverter x:Key="NameEquality" />
        <v:EnumEqualityConverter x:Key="EnumEquality" />
        <v:ViewSourceConverter x:Key="ViewSource" />
        <v:ThumbnailImageConverter x:Key="ThumbnailImage" />

        <!-- 툴바 버튼 32×28 · 아이콘 16 (docs/DESIGN.md §1·§7) -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 뷰 버튼 — 지금 뷰는 강조된다 (목업 .tbtn.on). 어느 뷰인가는 Tag 로 온다:
             ConverterParameter 는 바인딩이 될 수 없어 비교를 버튼마다 미리 접어 둔다. -->
        <Style x:Key="ViewButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers>
                <!-- Trigger 가 아니라 DataTrigger 다 — Tag 는 object 라 Trigger 의 Value 가
                     문자열 "True" 로 남고 bool 과 영원히 다르다 (실물에서 강조가 안 붙었다) -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Details 컬럼 헤더 버튼 — 클릭이 정렬이다 (ChangeSortCommand) -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 정렬 방향 표시 ▲/▼ (Segoe Fluent E70E/E70D · docs/DESIGN.md §6) -->
        <Style x:Key="SortGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
            <Setter Property="Text" Value="&#xE70E;" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Sort[0].Descending}" Value="True">
                    <Setter Property="Text" Value="&#xE70D;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ 항목 크롬 — 뷰 4종이 공유한다 (docs/DESIGN.md §6) ═══
             Tag 가 판정을 실어 나른다. 선택은 이름 집합이 들고 있으므로 (ADR-011) 행마다
             "내 이름이 집합에 있는가" 를 묻는다 — 가상화가 실현한 것만 계산한다. -->
        <Style x:Key="ItemSelection" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Tag">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource NameMembership}">
                        <Binding Path="DataContext.Selection.SelectedNames" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                        <Binding Path="Name" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
                <!-- 선택 — 비활성 페인은 강등된다. 뒤에 오는 트리거가 이기므로 순서가 규칙이다 -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelInactiveBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding Path=(v:PaneChrome.IsActive), RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource SelBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding Path=(v:PaneChrome.IsActive), RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource SelHoverBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 키보드 포커스 테두리 — 활성 페인에서만. 두께는 항상 1 이라 레이아웃이 흔들리지 않는다 -->
        <Style x:Key="ItemFocus" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Tag">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource NameEquality}">
                        <Binding Path="DataContext.FocusedName" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                        <Binding Path="Name" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding Path=(v:PaneChrome.IsActive), RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 아이콘·썸네일. 썸네일이 있으면 그것, 없으면 형식 아이콘이다 — 크기만 뷰가 정한다.
             96 요청은 SHIL_JUMBO 의 256×256 을 내므로 축소가 여기서 일어난다 -->
        <Style x:Key="ItemIcon" TargetType="Image">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="Source">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource ThumbnailImage}">
                        <Binding Path="Thumbnail" />
                        <Binding Path="Icon" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Details 행 (docs/DESIGN.md §2·§3) — 높이 24 고정 ═══ -->
        <DataTemplate x:Key="DetailsRow" DataType="{x:Type vm:FileItemViewModel}">
            <Border Style="{StaticResource ItemSelection}" Height="24">
                <Border Style="{StaticResource ItemFocus}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Style="{StaticResource ItemIcon}" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Margin="8,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Foreground="{StaticResource Text2Brush}" />
                        <TextBlock Grid.Column="2" Text="{Binding TypeText}" Margin="8,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text2Brush}" />
                        <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Margin="8,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Text2Brush}" />
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>

        <!-- ═══ 목록 뷰 (docs/DESIGN.md §2) — 항목 200×22, 가로 간격 12 ═══
             세로로 채우고 다음 열로 넘어간다. 그래서 합성 행 하나가 한 '열' 이다 (ADR-016). -->
        <DataTemplate x:Key="ListCell" DataType="{x:Type vm:FileItemViewModel}">
            <Border Style="{StaticResource ItemSelection}" Width="200" Height="22" Margin="0,0,12,0">
                <Border Style="{StaticResource ItemFocus}">
                    <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Style="{StaticResource ItemIcon}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ListRow" DataType="{x:Type vm:RowViewModel}">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ListCell}" Focusable="False" />
        </DataTemplate>

        <!-- ═══ 타일 뷰 (docs/DESIGN.md §2) — 높이 56, 아이콘 32, 최소 폭 220 가변 ═══ -->
        <DataTemplate x:Key="TileCell" DataType="{x:Type vm:FileItemViewModel}">
            <Border Style="{StaticResource ItemSelection}" Height="56" Margin="0,2,8,2">
                <Border Style="{StaticResource ItemFocus}">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Style="{StaticResource ItemIcon}" Width="32" Height="32" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TypeText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Text2Brush}" />
                            <TextBlock Text="{Binding SizeText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Text2Brush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>

        <!-- 칸 수를 행에서 받는다 — 항목 수로 나누면 두 칸뿐인 마지막 줄이 화면을 반씩 쓴다 -->
        <DataTemplate x:Key="TileRow" DataType="{x:Type vm:RowViewModel}">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileCell}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="{Binding Capacity}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- ═══ 큰 아이콘 뷰 (docs/DESIGN.md §2) — 항목 116×140, 썸네일 96, 이름 2줄 ═══ -->
        <DataTemplate x:Key="IconCell" DataType="{x:Type vm:FileItemViewModel}">
            <Border Style="{StaticResource ItemSelection}" Width="116" Height="140" Margin="0,4,8,4">
                <Border Style="{StaticResource ItemFocus}">
                    <StackPanel Margin="6" VerticalAlignment="Center">
                        <Image Style="{StaticResource ItemIcon}" Width="96" Height="96" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Width="104" Margin="0,4,0,0" TextAlignment="Center"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   LineHeight="14" LineStackingStrategy="BlockLineHeight" MaxHeight="28" />
                    </StackPanel>
                </Border>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="IconRow" DataType="{x:Type vm:RowViewModel}">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource IconCell}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- ═══ 목록 컨트롤 ═══
             가상화 필수 조합 (docs/ARCHITECTURE.md §5). 뷰 전환은 DataTemplate 교체이고
             (ADR-002) 컨트롤은 하나다. 뷰포트·보이는 범위는 패널이 민다 — 가상화 패널이
             스크롤 주인이라 그 크기가 곧 픽셀 뷰포트다. -->
        <ItemsPanelTemplate x:Key="VerticalItems">
            <VirtualizingStackPanel Orientation="Vertical"
                                    v:ViewportSync.Enabled="True"
                                    v:VisibleRangeSync.Enabled="True" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="HorizontalItems">
            <VirtualizingStackPanel Orientation="Horizontal"
                                    v:ViewportSync.Enabled="True"
                                    v:VisibleRangeSync.Enabled="True" />
        </ItemsPanelTemplate>

        <!-- 내장 선택·포커스를 쓰지 않는다 — 이동·선택은 ViewModel 이 한다 (ADR-016) -->
        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- 내장 type-ahead 를 끈다 — wrap 뷰에서 컨테이너는 항목이 아니라 행이라
                 (ADR-016) 엉뚱한 것을 고른다. 문자 키는 TypeAheadInput 이 받는다 -->
            <Setter Property="IsTextSearchEnabled" Value="False" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RowContainer}" />
            <Setter Property="ItemTemplate" Value="{StaticResource DetailsRow}" />
            <Setter Property="ItemsPanel" Value="{StaticResource VerticalItems}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
            <Style.Triggers>
                <!-- 목록 뷰만 가로 스크롤이다 — 세로로 채우고 다음 열로 넘어간다 (ADR-016) -->
                <DataTrigger Binding="{Binding ViewMode}" Value="List">
                    <Setter Property="ItemTemplate" Value="{StaticResource ListRow}" />
                    <Setter Property="ItemsPanel" Value="{StaticResource HorizontalItems}" />
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewMode}" Value="Tiles">
                    <Setter Property="ItemTemplate" Value="{StaticResource TileRow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewMode}" Value="LargeIcons">
                    <Setter Property="ItemTemplate" Value="{StaticResource IconRow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ 페인 하나 (좌우가 공유한다) ═══ -->
        <DataTemplate x:Key="PaneTemplate" DataType="{x:Type vm:PaneViewModel}">
            <!-- Ctrl+L·Alt+D 를 창이 아니라 여기서 받는다 — 키가 온 쪽이 곧 그 페인이다 -->
            <Border x:Name="PaneRoot" Background="{StaticResource PaneBgBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="6,6,0,0"
                    v:AddressFocus.Enabled="True">
                <DockPanel>
                    <!-- 툴바 36 (docs/DESIGN.md §1·§7) -->
                    <Border x:Name="ToolbarChrome" DockPanel.Dock="Top" Height="36"
                            Background="{StaticResource WinBgBrush}"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolButton}" Content="&#xE72B;" ToolTip="뒤로 (Alt+←)"
                                    Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" />
                            <Button Style="{StaticResource ToolButton}" Content="&#xE72A;" ToolTip="앞으로 (Alt+→)"
                                    Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" />
                            <Button Style="{StaticResource ToolButton}" Content="&#xE74A;" ToolTip="상위 폴더 (Alt+↑)"
                                    Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}" />
                            <Rectangle Width="1" Height="18" Margin="4,0" Fill="{StaticResource StrokeStrongBrush}" />
                            <Button Style="{StaticResource ToolButton}" Content="&#xE72C;" ToolTip="새로 고침 (F5)"
                                    Command="{Binding RefreshCommand}" />
                            <Rectangle Width="1" Height="18" Margin="4,0" Fill="{StaticResource StrokeStrongBrush}" />
                            <Button Style="{StaticResource ViewButton}" Content="&#xE8A4;" ToolTip="자세히 (Ctrl+Shift+1)"
                                    Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.Details}"
                                    Tag="{Binding ViewMode, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static state:ViewMode.Details}}" />
                            <Button Style="{StaticResource ViewButton}" Content="&#xE8FD;" ToolTip="목록 (Ctrl+Shift+2)"
                                    Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.List}"
                                    Tag="{Binding ViewMode, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static state:ViewMode.List}}" />
                            <Button Style="{StaticResource ViewButton}" Content="&#xE8A9;" ToolTip="타일 (Ctrl+Shift+3)"
                                    Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.Tiles}"
                                    Tag="{Binding ViewMode, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static state:ViewMode.Tiles}}" />
                            <!-- 큰 아이콘만 DESIGN §7 의 E8A6 이 아니다 — 그 자리는 잠긴 문서
                                 (ProtectedDocument) 글리프다. 큰 사각 하나로 바꿨다 -->
                            <Button Style="{StaticResource ViewButton}" Content="&#xE15B;" ToolTip="큰 아이콘 (Ctrl+Shift+4)"
                                    Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static state:ViewMode.LargeIcons}"
                                    Tag="{Binding ViewMode, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static state:ViewMode.LargeIcons}}" />
                        </StackPanel>
                    </Border>

                    <!-- 주소줄 28 · 입력 24 (docs/DESIGN.md §1) -->
                    <Border x:Name="AddrChrome" DockPanel.Dock="Top" Height="28"
                            Background="{StaticResource WinBgBrush}"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
                        <Border x:Name="AddrBox" Height="24" Margin="6,0,6,4" CornerRadius="4"
                                Background="{StaticResource PaneBgBrush}"
                                BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1">
                            <TextBox Text="{Binding AddressEdit, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" Margin="8,0,8,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{StaticResource TextBrush}"
                                     v:AddressFocus.IsAddressBox="True">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding OpenAddressCommand}"
                                                CommandParameter="{Binding AddressEdit}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Border>
                    </Border>

                    <Grid>
                        <DockPanel Margin="8,0">
                            <!-- Details 헤더 24 — 클릭 = 정렬 (탐색기와 같다). 다른 뷰에는 컬럼이 없다 -->
                            <Grid DockPanel.Dock="Top" Height="24"
                                  Visibility="{Binding ViewMode, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static state:ViewMode.Details}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="160" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource HeaderButton}"
                                        Command="{Binding ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="이름" />
                                        <TextBlock Style="{StaticResource SortGlyph}"
                                                   Visibility="{Binding DataContext.Sort[0].Key, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static sorting:SortKey.Name}}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right"
                                        Command="{Binding ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Size}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="크기" />
                                        <TextBlock Style="{StaticResource SortGlyph}"
                                                   Visibility="{Binding DataContext.Sort[0].Key, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static sorting:SortKey.Size}}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource HeaderButton}"
                                        Command="{Binding ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Type}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="유형" />
                                        <TextBlock Style="{StaticResource SortGlyph}"
                                                   Visibility="{Binding DataContext.Sort[0].Key, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static sorting:SortKey.Type}}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource HeaderButton}"
                                        Command="{Binding ChangeSortCommand}" CommandParameter="{x:Static sorting:SortKey.Modified}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="수정한 날짜" />
                                        <TextBlock Style="{StaticResource SortGlyph}"
                                                   Visibility="{Binding DataContext.Sort[0].Key, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static sorting:SortKey.Modified}}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 소스가 둘이다 — Details 는 평평한 Items, wrap 뷰 3종은 합성 행 (ADR-016) -->
                            <ListBox Style="{StaticResource PaneList}"
                                     v:TypeAheadInput.Enabled="True"
                                     v:FocusScroll.FocusedName="{Binding FocusedName}"
                                     v:FocusScroll.RenamingName="{Binding RenamingName}"
                                     v:ListInput.SelectCommand="{Binding SelectItemCommand}"
                                     v:ListInput.ToggleCommand="{Binding ToggleItemCommand}"
                                     v:ListInput.RangeCommand="{Binding RangeSelectItemCommand}"
                                     v:ListInput.OpenCommand="{Binding ActivateCommand}"
                                     v:ListInput.EmptyCommand="{Binding ClickBackgroundCommand}">
                                <ListBox.ItemsSource>
                                    <MultiBinding Converter="{StaticResource ViewSource}">
                                        <Binding Path="ViewMode" />
                                        <Binding Path="Items" />
                                        <Binding Path="Rows" />
                                    </MultiBinding>
                                </ListBox.ItemsSource>
                                <ListBox.InputBindings>
                                    <!-- 이동·선택 (docs/DESIGN.md §9) — 합성 행 위에서 내장 이동은 못 쓴다 -->
                                    <KeyBinding Key="Up" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Up}" />
                                    <KeyBinding Key="Down" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Down}" />
                                    <KeyBinding Key="Left" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Left}" />
                                    <KeyBinding Key="Right" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Right}" />
                                    <KeyBinding Key="Home" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Home}" />
                                    <KeyBinding Key="End" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.End}" />
                                    <KeyBinding Key="PageUp" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.PageUp}" />
                                    <KeyBinding Key="PageDown" Command="{Binding MoveFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.PageDown}" />
                                    <KeyBinding Key="Up" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Up}" />
                                    <KeyBinding Key="Down" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Down}" />
                                    <KeyBinding Key="Left" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Left}" />
                                    <KeyBinding Key="Right" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Right}" />
                                    <KeyBinding Key="Home" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.Home}" />
                                    <KeyBinding Key="End" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.End}" />
                                    <KeyBinding Key="PageUp" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.PageUp}" />
                                    <KeyBinding Key="PageDown" Modifiers="Shift" Command="{Binding ExtendFocusToCommand}" CommandParameter="{x:Static vm:FocusMove.PageDown}" />
                                    <KeyBinding Key="Up" Modifiers="Control" Command="{Binding FocusOnlyToCommand}" CommandParameter="{x:Static vm:FocusMove.Up}" />
                                    <KeyBinding Key="Down" Modifiers="Control" Command="{Binding FocusOnlyToCommand}" CommandParameter="{x:Static vm:FocusMove.Down}" />
                                    <KeyBinding Key="Left" Modifiers="Control" Command="{Binding FocusOnlyToCommand}" CommandParameter="{x:Static vm:FocusMove.Left}" />
                                    <KeyBinding Key="Right" Modifiers="Control" Command="{Binding FocusOnlyToCommand}" CommandParameter="{x:Static vm:FocusMove.Right}" />
                                    <KeyBinding Key="Space" Modifiers="Control" Command="{Binding ToggleFocusedCommand}" />
                                    <KeyBinding Key="Return" Command="{Binding OpenFocusedCommand}" />
                                </ListBox.InputBindings>
                            </ListBox>
                        </DockPanel>

                        <!-- 빈 폴더 (docs/UI_GUIDE.md §상태 표현 · 목업 문구 그대로) -->
                        <TextBlock x:Name="EmptyMessage" Text="이 폴더는 비어 있습니다."
                                   HorizontalAlignment="Center" Margin="0,120,0,0"
                                   Foreground="{StaticResource Text2Brush}" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Empty">
                    <Setter TargetName="EmptyMessage" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- 활성 페인 — 크롬 배경 승격 + 주소줄 accent (docs/DESIGN.md §6) -->
                <DataTrigger Binding="{Binding Path=(v:PaneChrome.IsActive), ElementName=PaneRoot}" Value="True">
                    <Setter TargetName="ToolbarChrome" Property="Background" Value="{StaticResource ChromeBgBrush}" />
                    <Setter TargetName="AddrChrome" Property="Background" Value="{StaticResource ChromeBgBrush}" />
                    <Setter TargetName="AddrBox" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="AddrBox" Property="BorderThickness" Value="1,1,1,2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- 페인 둘 + 스플리터 6 (docs/DESIGN.md §1). 비율은 복원·저장 대상이다 -->
        <Grid Margin="4,4,4,0"
              v:SplitterSync.Enabled="True"
              v:SplitterSync.Ratio="{Binding SplitterRatio, Mode=TwoWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource PaneTemplate}"
                            Focusable="False"
                            v:PaneChrome.IsActive="{Binding ActiveSide, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static vm:PaneSide.Left}}" />
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" Focusable="False">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>
            <ContentControl Grid.Column="2" Content="{Binding Right}" ContentTemplate="{StaticResource PaneTemplate}"
                            Focusable="False"
                            v:PaneChrome.IsActive="{Binding ActiveSide, Converter={StaticResource EnumEquality}, ConverterParameter={x:Static vm:PaneSide.Right}}" />
        </Grid>

        <!-- 상태표시줄 24 — 활성 페인의 문구 (docs/DESIGN.md §1·§6) -->
        <Border Grid.Row="1" Background="{StaticResource WinBgBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding ActivePane.StatusText}" Margin="12,0" VerticalAlignment="Center" FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActivePane.Status}" Value="Error">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
